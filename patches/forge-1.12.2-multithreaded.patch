+/**
+ * Persistent cache for baked models.
+ *
+ * Only plain {@link SimpleBakedModel} and {@link BuiltInModel} instances with
+ * {@link ItemOverrideList#NONE} overrides are cached. Custom mod IBakedModel classes are baked normally, so this
+ * can never change the behaviour of a custom renderer. Quads store sprite names and are rebound to the current
+ * TextureMap on load, which keeps them valid after every resource reload.
+ *
+ * Cache key = mod jar metadata + resource pack metadata + selected pack list + Forge/MC/cache version.
+ * Config files are intentionally not hashed (mods often rewrite them every launch); delete the cache directory
+ * after changing a model-affecting config.
+ */
+@SideOnly(Side.CLIENT)
+public final class ModelCache
+{
+    private static final Logger LOGGER = LogManager.getLogger("ForgeThreading");
+    private static final boolean ENABLED = !net.minecraftforge.common.threading.MemoryTrim.isLowMemory()
+            && Boolean.parseBoolean(System.getProperty("forge.threading.modelCache", "true"));
+    private static final int MAGIC = 0x464D4331;
+    private static final int VERSION = 1;
+    private static final int MAX_CACHE_FILES = 3;
+    private static volatile String cachedKey;
+    private static volatile boolean saveStarted;
+
+    private ModelCache()
+    {
+    }
+
+    public static void load(ModelBakery bakery)
+    {
+        if (!ENABLED)
+        {
+            return;
+        }
+
+        try
+        {
+            File file = cacheFile();
+            if (file == null || !file.isFile())
+            {
+                return;
+            }
+
+            long start = System.nanoTime();
+            IRegistry<ModelResourceLocation, IBakedModel> registry = bakery.getBakedRegistry();
+            TextureMap textureMap = bakery.getTextureMap();
+            int loaded = 0;
+            int skipped = 0;
+
+            try (DataInputStream in = new DataInputStream(new BufferedInputStream(new FileInputStream(file))))
+            {
+                if (in.readInt() != MAGIC || in.readInt() != VERSION)
+                {
+                    LOGGER.warn("[model-cache] ignoring incompatible cache {}", file.getName());
+                    return;
+                }
+                String key = in.readUTF();
+                if (!key.equals(key()))
+                {
+                    LOGGER.info("[model-cache] cache key changed, ignoring {}", file.getName());
+                    return;
+                }
+                int count = in.readInt();
+                for (int index = 0; index < count; index++)
+                {
+                    String location = in.readUTF();
+                    int length = in.readInt();
+                    byte[] data = new byte[length];
+                    in.readFully(data);
+                    try
+                    {
+                        IBakedModel model = deserializeModel(data, textureMap);
+                        if (model != null)
+                        {
+                            registry.putObject(new ModelResourceLocation(location), model);
+                            loaded++;
+                        }
+                        else
+                        {
+                            skipped++;
+                        }
+                    }
+                    catch (Throwable throwable)
+                    {
+                        skipped++;
+                    }
+                }
+            }
+
+            double ms = (System.nanoTime() - start) / 1.0E6D;
+            LOGGER.info("[model-cache] loaded {} models ({} skipped) in {} ms from {}", Integer.valueOf(loaded),
+                    Integer.valueOf(skipped), String.format("%.1f", Double.valueOf(ms)), file.getName());
+        }
+        catch (Throwable throwable)
+        {
+            LOGGER.warn("[model-cache] load failed; falling back to normal baking", throwable);
+        }
+    }
+
+    public static void saveAsync(ModelBakery bakery)
+    {
+        if (!ENABLED || saveStarted)
+        {
+            return;
+        }
+        synchronized (ModelCache.class)
+        {
+            if (saveStarted)
+            {
+                return;
+            }
+            saveStarted = true;
+        }
+
+        try
+        {
+            File file = cacheFile();
+            if (file == null || file.isFile())
+            {
+                return;
+            }
+            Thread thread = new Thread(() -> save(bakery, file), "ForgeModelCache-Save");
+            thread.setDaemon(true);
+            thread.start();
+        }
+        catch (Throwable throwable)
+        {
+            LOGGER.warn("[model-cache] could not start cache writer", throwable);
+        }
+    }
+
+    private static void save(ModelBakery bakery, File target)
+    {
+        File tmp = new File(target.getParentFile(), target.getName() + ".tmp");
+        long start = System.nanoTime();
+        int written = 0;
+
+        try
+        {
+            if (!target.getParentFile().isDirectory() && !target.getParentFile().mkdirs())
+            {
+                return;
+            }
+
+            IRegistry<ModelResourceLocation, IBakedModel> registry = bakery.getBakedRegistry();
+
+            Map<String, Integer> histogram = new java.util.HashMap<String, Integer>();
+            for (ModelResourceLocation location : registry.getKeys())
+            {
+                IBakedModel model = registry.getObject(location);
+                if (model != null)
+                {
+                    histogram.merge(model.getClass().getName(), Integer.valueOf(1), Integer::sum);
+                }
+            }
+            List<Map.Entry<String, Integer>> top = new ArrayList<Map.Entry<String, Integer>>(histogram.entrySet());
+            top.sort((a, b) -> Integer.compare(b.getValue().intValue(), a.getValue().intValue()));
+            for (int index = 0; index < Math.min(12, top.size()); index++)
+            {
+                LOGGER.info("[model-cache] class {} x{}", top.get(index).getKey(), top.get(index).getValue());
+            }
+
+            try (RandomAccessFile out = new RandomAccessFile(tmp, "rw"))
+            {
+                out.writeInt(MAGIC);
+                out.writeInt(VERSION);
+                out.writeUTF(key());
+                long countPosition = out.getFilePointer();
+                out.writeInt(0);
+
+                for (ModelResourceLocation location : registry.getKeys())
+                {
+                    IBakedModel model = registry.getObject(location);
+                    if (!isCacheable(model))
+                    {
+                        continue;
+                    }
+                    byte[] data = serializeModel(model);
+                    if (data == null)
+                    {
+                        continue;
+                    }
+                    out.writeUTF(location.toString());
+                    out.writeInt(data.length);
+                    out.write(data);
+                    written++;
+                }
+
+                out.seek(countPosition);
+                out.writeInt(written);
+            }
+
+            Files.move(tmp.toPath(), target.toPath(), StandardCopyOption.REPLACE_EXISTING);
+            double ms = (System.nanoTime() - start) / 1.0E6D;
+            LOGGER.info("[model-cache] saved {} models in {} ms to {}", Integer.valueOf(written),
+                    String.format("%.1f", Double.valueOf(ms)), target.getName());
+            cleanup(target.getParentFile());
+        }
+        catch (Throwable throwable)
+        {
+            LOGGER.warn("[model-cache] save failed", throwable);
+            if (tmp.isFile())
+            {
+                tmp.delete();
+            }
+        }
+    }
