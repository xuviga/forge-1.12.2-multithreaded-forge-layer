+    public static int getTrackedWorldCount()
+    {
+        return ENTITY_OWNERS.size();
+    }
+
+    public static void shutdown()
+    {
+        ENTITY_OWNERS.clear();
+        ExecutorService[] current = workers;
+        if (current != null)
+        {
+            for (int index = 0; index < current.length; index++)
+            {
+                if (current[index] != null)
+                {
+                    current[index].shutdownNow();
+                }
+            }
+            workers = null;
+        }
+
+        ExecutorService executor = pool;
+        if (executor != null)
+        {
+            executor.shutdownNow();
+            pool = null;
+        }
+    }
+
+    /**
+     * Submits a task to the single worker owning its region. This is the static region assignment: the same region
+     * always runs on the same thread, and an entity that crosses regions is naturally picked up by the new region's
+     * worker on the next tick.
+     */
+    private static Future<?> submit(final Region region, final Runnable task)
+    {
+        Runnable safeTask = new Runnable()
+        {
+            @Override
+            public void run()
+            {
+                try
+                {
+                    task.run();
+                }
+                catch (Throwable throwable)
+                {
+                    if (REGION_ERRORS_FATAL)
+                    {
+                        if (throwable instanceof RuntimeException)
+                        {
+                            throw (RuntimeException)throwable;
+                        }
+                        if (throwable instanceof Error)
+                        {
+                            throw (Error)throwable;
+                        }
+                        throw new RuntimeException(throwable);
+                    }
+
+                    long count = REGION_ERRORS.incrementAndGet();
+                    if (count <= 5L || count % 100L == 0L)
+                    {
+                        ThreadingTelemetry.increment("region.errors");
+                        LOGGER.error("[region-error] {} region={} task failed; continuing (hit #{})",
+                                Thread.currentThread().getName(), Integer.valueOf(region.getId()), Long.valueOf(count), throwable);
+                    }
+                }
+            }
+        };
+
+        if (Threading.isRegionAffinityEnabled())
+        {
+            ExecutorService[] current = getWorkers();
+            int slot = Math.floorMod(region.getId(), current.length);
+            return current[slot].submit(safeTask);
+        }
+        return getPool().submit(safeTask);
+    }
+
+    private static ExecutorService getPool()
+    {
+        ExecutorService executor = pool;
+        if (executor == null)
+        {
+            synchronized (RegionManager.class)
+            {
+                executor = pool;
+                if (executor == null)
+                {
+                    executor = Executors.newFixedThreadPool(Threading.getRegionThreads(), new ThreadFactory()
+                    {
+                        @Override
+                        public Thread newThread(Runnable runnable)
+                        {
+                            Thread thread = new Thread(net.minecraftforge.fml.common.thread.SidedThreadGroups.SERVER,
+                                    runnable, "Server Region Thread #" + THREAD_IDS.incrementAndGet());
+                            thread.setDaemon(true);
+                            return thread;
+                        }
+                    });
+                    pool = executor;
+                    ThreadingTelemetry.registerPool("region", executor);
+                }
+            }
+        }
+        return executor;
+    }
+
+    private static ExecutorService[] getWorkers()
+    {
+        ExecutorService[] current = workers;
+        if (current == null)
+        {
+            synchronized (RegionManager.class)
+            {
+                current = workers;
+                if (current == null)
+                {
+                    int count = Threading.getRegionThreads();
+                    current = new ExecutorService[count];
+                    for (int index = 0; index < count; index++)
+                    {
+                        current[index] = Executors.newSingleThreadExecutor(new ThreadFactory()
+                        {
+                            @Override
+                            public Thread newThread(Runnable runnable)
+                            {
+                                Thread thread = new Thread(net.minecraftforge.fml.common.thread.SidedThreadGroups.SERVER,
+                                        runnable, "Server Region Thread #" + THREAD_IDS.incrementAndGet());
+                                thread.setDaemon(true);
+                                return thread;
+                            }
+                        });
+                    }
+                    workers = current;
+                }
+            }
+        }
+        return current;
+    }
+
+    private static int regionId(int chunkX, int chunkZ, int size)
+    {
+        int regionX = Math.floorDiv(chunkX, size);
+        int regionZ = Math.floorDiv(chunkZ, size);
+        return (regionX & 0xffff) << 16 | (regionZ & 0xffff);
+    }
+
+    private static final class Bucket
+    {
+        private final Region region;
+        private final List<Entity> entities = new ArrayList<Entity>();
+
+        private Bucket(Region region)
+        {
+            this.region = region;
+        }
+    }
+
+    private static final class TileBucket
+    {
+        private final Region region;
+        private final List<TileEntity> tileEntities = new ArrayList<TileEntity>();
+
+        private TileBucket(Region region)
+        {
+            this.region = region;
+        }
+    }
+
+    private static final class ChunkBucket
+    {
+        private final Region region;
+        private final List<Chunk> chunks = new ArrayList<Chunk>();
+
+        private ChunkBucket(Region region)
+        {
+            this.region = region;
+        }
+    }
+
+    private static final class UpdateBucket
+    {
+        private final Region region;
+        private final List<net.minecraft.world.NextTickListEntry> entries =
+                new ArrayList<net.minecraft.world.NextTickListEntry>();
+
+        private UpdateBucket(Region region)
+        {
+            this.region = region;
+        }
+    }
+}
diff --git a/net/minecraftforge/common/threading/StatsOverlay.java b/net/minecraftforge/common/threading/StatsOverlay.java
new file mode 100644
index 0000000..dc1db7c
--- /dev/null
+++ b/net/minecraftforge/common/threading/StatsOverlay.java
@@ -0,0 +1,320 @@
+/*
+ * Minecraft Forge
+ * Copyright (c) 2016-2020.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation version 2.1
+ * of the License.
+ */
+
+package net.minecraftforge.common.threading;
+
+import com.sun.jna.Library;
+import com.sun.jna.Memory;
+import com.sun.jna.Native;
+import com.sun.jna.Pointer;
+import com.sun.jna.ptr.IntByReference;
+import java.lang.management.ManagementFactory;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.gui.Gui;
+import net.minecraft.client.gui.ScaledResolution;
+import net.minecraftforge.fml.relauncher.Side;
+import net.minecraftforge.fml.relauncher.SideOnly;
+
+/**
+ * Top-right performance overlay: real FPS, frame time, TPS/MSPT, heap, physical RAM and per-core CPU load.
+ *
+ * CPU sampling uses NtQuerySystemInformation(SystemProcessorPerformanceInformation) through the JNA 4.4 core
+ * already shipped with Minecraft 1.12.2. This works on Windows without jna-platform; OSHI 1.1's per-core path is
+ * unusable there. Sampling runs on a daemon thread and is cached, so the render path never blocks.
+ *
+ * Toggle: F8 by default (key.stats_overlay in Controls) or Options -> Stats Overlay.
+ */
+@SideOnly(Side.CLIENT)
+public final class StatsOverlay
+{
+    private static final int MAX_CORES = 32;
+    private static final long SAMPLE_MS = 1000L;
+    private static final int SYSTEM_PROCESSOR_PERFORMANCE_INFORMATION = 8;
+    private static final int PROCESSOR_INFO_SIZE = 48;
+
+    private static volatile boolean keyHeld;
+    private static volatile float[] coreLoads = new float[0];
+    private static volatile long totalRam;
+    private static volatile long availableRam;
+    private static volatile float overallCpu;
+    private static volatile boolean samplerStarted;
+    private static volatile boolean jnaFailed;
+    private static volatile boolean renderFailed;
+    private static volatile java.lang.management.OperatingSystemMXBean osBean;
+    private static volatile long[] prevIdle;
+    private static volatile long[] prevKernel;
+    private static volatile long[] prevUser;
+
+    private StatsOverlay()
+    {
+    }
+
+    public interface NtDll extends Library
+    {
+        NtDll INSTANCE = (NtDll)Native.loadLibrary("ntdll", NtDll.class);
+        int NtQuerySystemInformation(int infoClass, Pointer info, int length, IntByReference returned);
+    }
+
+    private static void ensureSampler()
+    {
+        if (samplerStarted)
+        {
+            return;
+        }
+        synchronized (StatsOverlay.class)
+        {
+            if (samplerStarted)
+            {
+                return;
+            }
+            samplerStarted = true;
+            Thread thread = new Thread(StatsOverlay::sampleLoop, "ForgeStatsSampler");
+            thread.setDaemon(true);
+            thread.start();
+        }
+    }
+
+    private static void sampleLoop()
+    {
+        try
+        {
+            osBean = ManagementFactory.getOperatingSystemMXBean();
+        }
+        catch (Throwable ignored)
+        {
+        }
+
+        int count = Math.min(MAX_CORES, Runtime.getRuntime().availableProcessors());
+        Memory memory = null;
+        IntByReference returned = new IntByReference();
+        try
+        {
+            memory = new Memory((long)count * (long)PROCESSOR_INFO_SIZE);
+        }
+        catch (Throwable throwable)
+        {
+            jnaFailed = true;
+        }
+
+        while (true)
+        {
+            try
+            {
+                if (memory != null && !jnaFailed)
+                {
+                    int status = NtDll.INSTANCE.NtQuerySystemInformation(SYSTEM_PROCESSOR_PERFORMANCE_INFORMATION,
+                            memory, (int)memory.size(), returned);
+                    if (status != 0)
+                    {
+                        jnaFailed = true;
+                    }
+                    else
+                    {
+                        long[] idle = new long[count];
+                        long[] kernel = new long[count];
+                        long[] user = new long[count];
+                        for (int index = 0; index < count; index++)
+                        {
+                            long base = (long)index * (long)PROCESSOR_INFO_SIZE;
+                            idle[index] = memory.getLong(base);
+                            kernel[index] = memory.getLong(base + 8L);
+                            user[index] = memory.getLong(base + 16L);
+                        }
+
+                        long[] oldIdle = prevIdle;
+                        long[] oldKernel = prevKernel;
+                        long[] oldUser = prevUser;
+                        if (oldIdle != null && oldIdle.length == count)
+                        {
+                            float[] loads = new float[count];
+                            float sum = 0.0F;
+                            for (int index = 0; index < count; index++)
+                            {
+                                long di = idle[index] - oldIdle[index];
+                                long dk = kernel[index] - oldKernel[index];
+                                long du = user[index] - oldUser[index];
+                                long total = di + dk + du;
+                                float load = total <= 0L ? 0.0F : (float)((double)(total - di) / (double)total);
+                                if (load < 0.0F)
+                                {
+                                    load = 0.0F;
+                                }
+                                if (load > 1.0F)
+                                {
+                                    load = 1.0F;
+                                }
+                                loads[index] = load;
+                                sum += load;
+                            }
+                            coreLoads = loads;
+                            overallCpu = sum / (float)Math.max(1, count);
+                        }
+                        prevIdle = idle;
+                        prevKernel = kernel;
+                        prevUser = user;
+                    }
+                }
+
+                if (osBean instanceof com.sun.management.OperatingSystemMXBean)
+                {
+                    com.sun.management.OperatingSystemMXBean sun = (com.sun.management.OperatingSystemMXBean)osBean;
+                    totalRam = sun.getTotalPhysicalMemorySize();
+                    availableRam = sun.getFreePhysicalMemorySize();
+                    if (jnaFailed || coreLoads.length == 0)
+                    {
+                        double load = sun.getSystemCpuLoad();
+                        overallCpu = load < 0.0D ? 0.0F : (float)load;
+                    }
+                }
+            }
+            catch (Throwable throwable)
+            {
+                jnaFailed = true;
+            }
+
+            try
+            {
+                Thread.sleep(SAMPLE_MS);
+            }
+            catch (InterruptedException interrupted)
+            {
+                Thread.currentThread().interrupt();
+                return;
+            }
+        }
+    }
+
+    public static void render(Minecraft mc)
+    {
+        ensureSampler();
+
+        if (renderFailed || mc == null || mc.gameSettings == null || mc.fontRenderer == null || !mc.gameSettings.statsOverlay)
+        {
+            return;
+        }
+
+        try
+        {
+            draw(mc);
+        }
+        catch (Throwable throwable)
+        {
+            renderFailed = true;
+        }
+    }
+
+    private static void draw(Minecraft mc)
+    {
+        ScaledResolution resolution = new ScaledResolution(mc);
+        int screenWidth = resolution.getScaledWidth();
+        int lineHeight = 10;
+        float[] cores = coreLoads;
+        int coreColumns = cores.length > 0 ? Math.min(16, cores.length) : 0;
+        int coreRows = cores.length > coreColumns ? 2 : 1;
+        int width = 218;
+        int height = 8 + lineHeight * (7 + coreRows);
+        int x = screenWidth - width - 4;
+        int y = 4;
+
+        Gui.drawRect(x, y, x + width, y + height, 0x90000000);
+        Gui.drawRect(x, y, x + 1, y + height, 0xFF3AA0FF);
+
+        int textX = x + 6;
+        int textY = y + 5;
+        Runtime runtime = Runtime.getRuntime();
+        long heapUsed = runtime.totalMemory() - runtime.freeMemory();
+        long heapMax = runtime.maxMemory();
+        int fps = Minecraft.getDebugFPS();
+        double frameMs = ThreadingMetrics.getLastClientFrameMs();
+        double frameMax = ThreadingMetrics.getLastClientMaxMs();
+        double mspt = ThreadingMetrics.getLastMspt();
+        double msptMax = ThreadingMetrics.getLastMaxMspt();
+        double tps = ThreadingMetrics.getLastTps();
+        long physicalTotal = totalRam;
+        long physicalFree = availableRam;
+        long physicalUsed = physicalTotal > 0 && physicalFree >= 0 ? physicalTotal - physicalFree : 0;
+
+        drawLine(mc, textX, textY, String.format("FPS %d  frame %.1f/%.1f ms", Integer.valueOf(fps), Double.valueOf(frameMs), Double.valueOf(frameMax)), 0xFFFFFFFF);
+        textY += lineHeight;
+        drawLine(mc, textX, textY, String.format("TPS %.2f  MSPT %.1f/%.1f ms", Double.valueOf(tps), Double.valueOf(mspt), Double.valueOf(msptMax)), tps >= 19.0D ? 0xFF55FF55 : 0xFFFFAA00);
+        textY += lineHeight;
+        drawLine(mc, textX, textY, String.format("Heap %.0f/%.0f MB", Double.valueOf(heapUsed / 1048576.0D), Double.valueOf(heapMax / 1048576.0D)), 0xFFCCCCCC);
+        textY += lineHeight;
+        if (physicalTotal > 0)
+        {
+            drawLine(mc, textX, textY, String.format("RAM %.1f/%.1f GB", Double.valueOf(physicalUsed / 1073741824.0D), Double.valueOf(physicalTotal / 1073741824.0D)), 0xFFCCCCCC);
+        }
+        else
+        {
+            drawLine(mc, textX, textY, "RAM sampling...", 0xFFCCCCCC);
+        }
+        textY += lineHeight;
+        drawLine(mc, textX, textY, String.format("CPU %.1f%%  threads %d  regions %d", Double.valueOf(overallCpu * 100.0F), Integer.valueOf(Thread.activeCount()), Integer.valueOf(Threading.getRegionThreads())), cpuColor(overallCpu));
+        textY += lineHeight;
+        drawLine(mc, textX, textY, String.format("LOD %d/%d/%d sim%d skip%d",
+                Integer.valueOf(RegionManager.getLodNear()), Integer.valueOf(RegionManager.getLodMid()),
+                Integer.valueOf(RegionManager.getLodFar()), Integer.valueOf(Threading.getDynamicSimulationDistance()),
+                Long.valueOf(ThreadingTelemetry.counter("entity.lod.skipped"))), 0xFFCCCCCC);
+        textY += lineHeight;
+
+        if (cores.length > 0)
+        {
+            drawLine(mc, textX, textY, "Cores", 0xFFCCCCCC);
+            textY += lineHeight;
+            int barWidth = 11;
+            int gap = 2;
+            int barHeight = 8;
+            for (int index = 0; index < cores.length; index++)
+            {
+                int column = index % coreColumns;
+                int row = index / coreColumns;
+                int barX = textX + column * (barWidth + gap);
+                int barY = textY + row * (barHeight + 3);
+                Gui.drawRect(barX, barY, barX + barWidth, barY + barHeight, 0x60000000);
+                int fill = Math.max(1, Math.round(cores[index] * barHeight));
+                Gui.drawRect(barX, barY + barHeight - fill, barX + barWidth, barY + barHeight, cpuColor(cores[index]));
+                mc.fontRenderer.drawStringWithShadow(String.valueOf(index % 10), barX + 3, barY + barHeight + 1, 0xFFAAAAAA);
+            }
+        }
+        else
+        {
+            drawLine(mc, textX, textY, jnaFailed ? "Cores: JNA unavailable" : "Cores: sampling...", 0xFFFFAA00);
+        }
+    }
+
+    private static void drawLine(Minecraft mc, int x, int y, String text, int color)
+    {
+        mc.fontRenderer.drawStringWithShadow(text, x, y, color);
+    }
+
+    private static int cpuColor(float load)
+    {
+        if (load >= 0.85F)
+        {
+            return 0xFFFF5555;
+        }
+        if (load >= 0.60F)
+        {
+            return 0xFFFFAA00;
+        }
+        return 0xFF55FF55;
+    }
+
+    /** True while the toggle key is held; Minecraft uses this for edge detection. */
+    public static boolean isKeyHeld()
+    {
+        return keyHeld;
+    }
+
+    public static void setKeyHeld(boolean held)
+    {
+        keyHeld = held;
+    }
+}
diff --git a/net/minecraftforge/common/threading/ThreadAudit.java b/net/minecraftforge/common/threading/ThreadAudit.java
new file mode 100644
index 0000000..65e673e
--- /dev/null
+++ b/net/minecraftforge/common/threading/ThreadAudit.java
@@ -0,0 +1,258 @@
+/*
+ * Minecraft Forge
+ * Copyright (c) 2016-2020.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation version 2.1
+ * of the License.
+ */
+
+package net.minecraftforge.common.threading;
+
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicLong;
+
+import net.minecraft.world.World;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+/**
+ * Phase 0 developer aid for the multithreaded fork.
+ *
+ * It records the client and server game threads and logs accesses that happen from any other thread. The checks are
+ * cheap no-ops unless auditing is enabled, so they can stay in production builds:
+ *
+ *   -Dforge.threading=audit
+ *   -Dforge.threading.audit=true
+ *
+ * This class deliberately does not throw. Phase 0 only measures how many mods and vanilla paths assume a single
+ * thread; hard failures become available in a later phase once the compatibility reports are in.
+ */
+public final class ThreadAudit
+{
+    private static final Logger LOGGER = LogManager.getLogger("ForgeThreading");
+    private static final boolean ENABLED =
+            "audit".equalsIgnoreCase(System.getProperty("forge.threading", "")) ||
+            Boolean.parseBoolean(System.getProperty("forge.threading.audit", "false"));
+    private static final int LOG_BURST = 20;
+    private static final long LOG_EVERY = 1000L;
+
+    private static volatile Thread clientThread;
+    private static volatile Thread serverThread;
+
+    private static final AtomicLong violations = new AtomicLong();
+    private static final AtomicLong inlineMainHandlers = new AtomicLong();
+    private static final ConcurrentHashMap<String, AtomicLong> perSite = new ConcurrentHashMap<String, AtomicLong>();
+
+    private ThreadAudit()
+    {
+    }
+
+    public static boolean isEnabled()
+    {
+        return ENABLED;
+    }
+
+    public static void markClientThread()
+    {
+        clientThread = Thread.currentThread();
+    }
+
+    public static void markClientThread(Thread thread)
+    {
+        clientThread = thread;
+    }
+
+    public static void markServerThread()
+    {
+        serverThread = Thread.currentThread();
+    }
+
+    public static void markServerThread(Thread thread)
+    {
+        serverThread = thread;
+    }
+
+    public static Thread getClientThread()
+    {
+        return clientThread;
+    }
+
+    public static Thread getServerThread()
+    {
+        return serverThread;
+    }
+
+    public static long getViolationCount()
+    {
+        return violations.get();
+    }
+
+    /**
+     * Verifies that the current thread owns the given world. Client worlds are owned by the client thread, server
+     * worlds by the server thread.
+     */
+    public static void assertWorldThread(World world, String action)
+    {
+        if (!ENABLED || world == null)
+        {
+            return;
+        }
+
+        // A thread that published this world as its TickContext owns it, even if it is a dimension or region worker.
+        TickContext context = TickContext.current();
+        if (context != null && context.getWorld() == world)
+        {
+            return;
+        }
+
+        // The client simulation thread legitimately owns the client world for weather/entity ticking.
+        if (world.isRemote && ClientSimulationThread.isSimulationThread())
+        {
+            return;
+        }
+
+        Thread expected = world.isRemote ? clientThread : serverThread;
+        if (expected != null && Thread.currentThread() != expected)
+        {
+            report(expected, world.isRemote ? "client" : "server", action);
+        }
+    }
+
+    /**
+     * Records an event listener that was skipped because its declared thread type did not match the current thread.
+     */
+    /**
+     * Records a legacy MAIN handler executed inline on a worker because forwarding to the owner was disabled.
+     */
+    public static void recordInlineMainHandler(String listener)
+    {
+        ThreadingTelemetry.increment("event.inline");
+        if (!ENABLED)
+        {
+            return;
+        }
+        long count = inlineMainHandlers.incrementAndGet();
+        if (count <= LOG_BURST || count % LOG_EVERY == 0L)
+        {
+            LOGGER.warn("[thread-audit] MAIN handler executed inline on {} (inline #{}, audit enabled): {}",
+                    Thread.currentThread().getName(), Long.valueOf(count), listener);
+        }
+    }
+
+    public static void recordSkippedListener(String listener)
+    {
+        ThreadingTelemetry.increment("event.skipped");
+        if (!ENABLED)
+        {
+            return;
+        }
+        record("event:" + listener);
+    }
+
+    private static void record(String action)
+    {
+        long count = violations.incrementAndGet();
+        AtomicLong siteCount = perSite.computeIfAbsent(action, k -> new AtomicLong());
+        long n = siteCount.incrementAndGet();
+        if (n <= LOG_BURST || n % LOG_EVERY == 0)
+        {
+            LOGGER.warn("[thread-audit] skipped/denied {} (violation #{}, site hit #{})", action, count, n,
+                    new Throwable("thread-audit stack"));
+        }
+    }
+
+    public static void assertServerThread(String action)
+    {
+        if (!ENABLED)
+        {
+            return;
+        }
+
+        Thread expected = serverThread;
+        if (expected != null && Thread.currentThread() != expected)
+        {
+            report(expected, "server", action);
+        }
+    }
+
+    public static void assertClientThread(String action)
+    {
+        if (!ENABLED)
+        {
+            return;
+        }
+
+        Thread expected = clientThread;
+        if (expected != null && Thread.currentThread() != expected)
+        {
+            report(expected, "client", action);
+        }
+    }
+
+    /**
+     * Logs when a region worker touches an entity owned by a different region (cross-region AI/targeting race).
+     */
+    public static void assertEntityOwner(net.minecraft.entity.Entity entity, String action)
+    {
+        if (!ENABLED || entity == null)
+        {
+            return;
+        }
+
+        TickContext context = currentContext();
+        if (context == null || context.getRegion() == null)
+        {
+            return;
+        }
+
+        Region owner = RegionManager.getEntityOwner(entity);
+        if (owner != null && !owner.equals(context.getRegion()))
+        {
+            record("entity:" + action);
+        }
+    }
+
+    /**
+     * @return true when the current region worker does not own the given entity.
+     */
+    public static boolean isCrossRegion(net.minecraft.entity.Entity entity)
+    {
+        TickContext context = TickContext.current();
+        if (context == null || context.getRegion() == null || entity == null)
+        {
+            return false;
+        }
+        Region owner = RegionManager.getEntityOwner(entity);
+        return owner != null && !owner.equals(context.getRegion());
+    }
+
+    public static void recordDeferredCrossRegion(String action)
+    {
+        ThreadingTelemetry.increment("event.deferred");
+        if (ENABLED)
+        {
+            record("deferred:" + action);
+        }
+    }
+
+    private static TickContext currentContext()
+    {
+        return TickContext.current();
+    }
+
+    private static void report(Thread expected, String side, String action)
+    {
+        long count = violations.incrementAndGet();
+        AtomicLong siteCount = perSite.computeIfAbsent(action, k -> new AtomicLong());
+        long n = siteCount.incrementAndGet();
+
+        if (n <= LOG_BURST || n % LOG_EVERY == 0)
+        {
+            LOGGER.warn("[thread-audit] {} called off the {} thread (expected '{}', actual '{}', violation #{}, site hit #{})",
+                    action, side, expected.getName(), Thread.currentThread().getName(), count, n,
+                    new Throwable("thread-audit stack"));
+        }
+    }
+}
diff --git a/net/minecraftforge/common/threading/ThreadAwareRandom.java b/net/minecraftforge/common/threading/ThreadAwareRandom.java
new file mode 100644
index 0000000..3608099
--- /dev/null
+++ b/net/minecraftforge/common/threading/ThreadAwareRandom.java
@@ -0,0 +1,122 @@
+/*
+ * Minecraft Forge
+ * Copyright (c) 2016-2020.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation version 2.1
+ * of the License.
+ */
+
+package net.minecraftforge.common.threading;
+
+import java.util.Random;
+
+/**
+ * World.rand replacement for regionized ticking.
+ *
+ * On the owner thread it delegates to the ordinary per-world Random (vanilla sequence preserved). On a region worker
+ * it uses a thread-local Random reseeded deterministically from (world seed, tick id, region id), so entity/TE code
+ * that calls world.rand no longer interleaves with other regions and replayed ticks are stable.
+ *
+ * The field type stays java.util.Random, so mods keep compiling and calling the same API.
+ */
+public final class ThreadAwareRandom extends Random
+{
+    private static final long serialVersionUID = 1L;
+
+    private final long worldSeed;
+    private volatile long generation;
+    private volatile long baseSeed;
+    private transient Delegate base;
+
+    private static final ThreadLocal<State> REGION_STATE = new ThreadLocal<State>()
+    {
+        @Override
+        protected State initialValue()
+        {
+            return new State();
+        }
+    };
+
+    public ThreadAwareRandom(long worldSeed)
+    {
+        super(worldSeed);
+        this.worldSeed = worldSeed;
+        this.baseSeed = worldSeed;
+        this.base = new Delegate(worldSeed);
+    }
+
+    @Override
+    protected int next(int bits)
+    {
+        TickContext context = TickContext.current();
+        if (context != null && context.getRegion() != null)
+        {
+            State state = REGION_STATE.get();
+            long tickId = context.getTickId();
+            int regionId = context.getRegion().getId();
+            int phase = context.getPhase().ordinal();
+            long version = generation;
+            // If the worker published a per-entity/TE/chunk key, use it instead of the region id. This makes the
+            // RNG stream independent of region size and of how work is distributed across threads.
+            long rngKey = context.hasRngKey() ? context.getRngKey()
+                    : (((long)regionId) << 32) ^ 0xD1B54A32D192ED03L;
+
+            if (state.random == null || state.tickId != tickId || state.key != rngKey || state.phase != phase || state.version != version)
+            {
+                long seed = worldSeed ^ (tickId * 0x9e3779b97f4a7c15L) ^ rngKey ^
+                        (((long)phase) * 0x94d049bb133111ebL) ^ (version * 0xbf58476d1ce4e5b9L);
+                state.random = new Delegate(seed);
+                state.tickId = tickId;
+                state.key = rngKey;
+                state.phase = phase;
+                state.version = version;
+            }
+            return state.random.nextBits(bits);
+        }
+
+        return base.nextBits(bits);
+    }
+
+    @Override
+    public synchronized void setSeed(long seed)
+    {
+        this.baseSeed = seed;
+        this.generation++;
+        Delegate current = this.base;
+        if (current != null)
+        {
+            current.setSeed(seed);
+        }
+    }
+
+    public long getWorldSeed()
+    {
+        return worldSeed;
+    }
+
+    private static final class Delegate extends Random
+    {
+        private static final long serialVersionUID = 1L;
+
+        private Delegate(long seed)
+        {
+            super(seed);
+        }
+
+        private int nextBits(int bits)
+        {
+            return super.next(bits);
+        }
+    }
+
+    private static final class State
+    {
+        private Delegate random;
+        private long tickId;
+        private long key;
+        private int phase;
+        private long version = -1L;
+    }
+}
