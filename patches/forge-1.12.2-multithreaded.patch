+import net.minecraft.world.WorldServer;
+
+public class CommandForgePregen extends CommandBase
+{
+    @Override
+    public String getName()
+    {
+        return "forgepregen";
+    }
+
+    @Override
+    public String getUsage(ICommandSender sender)
