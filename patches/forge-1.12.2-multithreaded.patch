+                    // animation override only matters for Forge animation properties, which this pack does not use.
+                    out.writeByte(0);
+                    writeTransforms(out, model.getItemCameraTransforms());
+                    out.writeBoolean(model.isAmbientOcclusion());
+                    out.writeBoolean(model.isGui3d());
+                    TextureAtlasSprite particle = model.getParticleTexture();
+                    out.writeUTF(particle == null ? "" : particle.getIconName());
+                    writeQuads(out, model.getQuads(null, null, 0L));
+                    for (EnumFacing facing : EnumFacing.values())
+                    {
+                        writeQuads(out, model.getQuads(null, facing, 0L));
+                    }
+                }
+                else
+                {
+                    return null;
+                }
+            }
