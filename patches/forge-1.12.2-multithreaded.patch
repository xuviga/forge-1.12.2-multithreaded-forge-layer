+    /**
+     * Test harness used by the performance runs. Completely inert unless the matching system properties are set, so
+     * it has no effect on normal play.
+     *
+     * -Dforge.threading.spinCameraDegrees=15 rotates the view every tick after spinCameraDelayMs.
+     * -Dforge.threading.exitAfterSeconds=30 shuts the client down cleanly after the measurement window.
+     */
+    private void applyAutomationHooks()
+    {
+        float spin = 0.0F;
+        String spinProperty = System.getProperty("forge.threading.spinCameraDegrees", "");
+
+        if (!spinProperty.isEmpty())
+        {
+            try
+            {
+                spin = Float.parseFloat(spinProperty);
+            }
+            catch (NumberFormatException ignored)
+            {
+                spin = 0.0F;
+            }
+        }
+
+        int exitAfterSeconds = Integer.getInteger("forge.threading.exitAfterSeconds", 0).intValue();
+        int dumpAfterSeconds = Integer.getInteger("forge.threading.dumpAfterSeconds", 0).intValue();
+
+        if (spin == 0.0F && exitAfterSeconds <= 0 && dumpAfterSeconds <= 0)
+        {
+            return;
+        }
+
+        long now = System.nanoTime();
+
+        if (this.automationStartNanos == 0L)
+        {
+            this.automationStartNanos = now;
+        }
+
+        long elapsedMs = (now - this.automationStartNanos) / 1000000L;
+
+        if (spin != 0.0F && this.player != null && !this.isGamePaused)
+        {
+            int delayMs = Integer.getInteger("forge.threading.spinCameraDelayMs", 2000).intValue();
+
+            if (elapsedMs >= (long)delayMs)
+            {
+                // Reset the previous values as well: the point is to make the visible chunk set change as abruptly as
+                // a mouse flick, not to simulate a smooth camera pan.
+                this.player.rotationYaw += spin;
+                this.player.rotationYaw %= 360.0F;
+                this.player.prevRotationYaw = this.player.rotationYaw;
+            }
+        }
+
+        if (dumpAfterSeconds > 0 && !this.automationTelemetryDumped && elapsedMs >= (long)dumpAfterSeconds * 1000L)
+        {
+            this.automationTelemetryDumped = true;
+
+            try
+            {
+                net.minecraftforge.common.threading.ThreadingTelemetry.dumpToFile();
+            }
+            catch (Throwable throwable)
+            {
+                LOGGER.warn("Could not dump threading telemetry", throwable);
+            }
+        }
+
+        if (exitAfterSeconds > 0 && elapsedMs >= (long)exitAfterSeconds * 1000L)
+        {
+            this.shutdown();
+        }
+    }
