+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation version 2.1
+ * of the License.
+ */
+
+package net.minecraftforge.common.memory;
+
+import java.io.File;
+import java.io.IOException;
+import java.util.Collections;
+import java.util.List;
+
+import javax.annotation.Nullable;
+
+import net.minecraft.command.CommandBase;
+import net.minecraft.command.CommandException;
+import net.minecraft.command.ICommandSender;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.util.math.BlockPos;
+import net.minecraft.util.text.TextComponentString;
+
+/**
+ * /forgemem [status|purge|gc|aggressive on|off|capability on|off|dump]
+ *
+ * status  - heap, world/leak counters and the capability-owner audit.
+ * purge   - drop finished chunk-IO tasks and reset leak tracking.
+ * gc      - explicit diagnostic full GC, then report.
+ * aggressive - toggle the reflective mod-static reference purger (also controls future unloads).
+ * capability - toggle the weak capability-owner audit.
+ * dump    - write the report to logs/forgemem-&lt;timestamp&gt;.txt.
+ */
+public class CommandForgeMemory extends CommandBase
+{
+    @Override
+    public String getName()
+    {
+        return "forgemem";
+    }
+
+    @Override
+    public String getUsage(ICommandSender sender)
+    {
+        return "/forgemem [status|purge|gc|aggressive on|off|capability on|off|dump]";
+    }
+
+    @Override
+    public int getRequiredPermissionLevel()
+    {
+        return 2;
+    }
+
+    @Override
+    public void execute(MinecraftServer server, ICommandSender sender, String[] args) throws CommandException
+    {
+        if (args.length == 0 || "status".equalsIgnoreCase(args[0]))
+        {
+            sendLines(sender, MemoryLeakGuard.audit());
+            return;
+        }
+
+        if ("purge".equalsIgnoreCase(args[0]))
+        {
+            sendLines(sender, MemoryLeakGuard.purge());
+            return;
+        }
+
+        if ("gc".equalsIgnoreCase(args[0]))
+        {
+            sendLines(sender, MemoryLeakGuard.gc());
+            return;
+        }
+
+        if ("dump".equalsIgnoreCase(args[0]))
+        {
+            try
+            {
+                File file = MemoryLeakGuard.writeDump();
+                sender.sendMessage(new TextComponentString("Forge memory audit written to " + file.getAbsolutePath()));
+            }
+            catch (IOException exception)
+            {
+                throw new CommandException("Could not write memory audit: " + exception.getMessage());
+            }
+            return;
+        }
+
+        if ("aggressive".equalsIgnoreCase(args[0]))
+        {
+            if (args.length == 1)
+            {
+                sender.sendMessage(new TextComponentString("aggressive=" + MemoryLeakGuard.isAggressive()));
+                return;
+            }
+            if ("on".equalsIgnoreCase(args[1]))
+            {
+                MemoryLeakGuard.setAggressive(true);
+                sender.sendMessage(new TextComponentString("Forge memory aggressive mod-static purge enabled"));
+                return;
+            }
+            if ("off".equalsIgnoreCase(args[1]))
+            {
+                MemoryLeakGuard.setAggressive(false);
+                sender.sendMessage(new TextComponentString("Forge memory aggressive mod-static purge disabled"));
+                return;
+            }
+            throw new CommandException(getUsage(sender));
+        }
+
+        if ("capability".equalsIgnoreCase(args[0]))
+        {
+            if (args.length == 1)
+            {
+                sender.sendMessage(new TextComponentString("capabilityAudit=" + CapabilityLeakTracker.isEnabled()));
+                return;
+            }
+            if ("on".equalsIgnoreCase(args[1]))
+            {
+                CapabilityLeakTracker.setEnabled(true);
+                sender.sendMessage(new TextComponentString("Capability-owner weak audit enabled"));
+                return;
+            }
+            if ("off".equalsIgnoreCase(args[1]))
+            {
+                CapabilityLeakTracker.setEnabled(false);
+                sender.sendMessage(new TextComponentString("Capability-owner weak audit disabled"));
+                return;
+            }
+            throw new CommandException(getUsage(sender));
+        }
+
+        throw new CommandException(getUsage(sender));
+    }
+
+    private static void sendLines(ICommandSender sender, List<String> lines)
+    {
+        for (String line : lines)
+        {
+            sender.sendMessage(new TextComponentString(line));
+        }
+    }
+
+    @Override
+    public List<String> getTabCompletions(MinecraftServer server, ICommandSender sender, String[] args, @Nullable BlockPos targetPos)
+    {
+        if (args.length == 1)
+        {
+            return getListOfStringsMatchingLastWord(args, "status", "purge", "gc", "aggressive", "capability", "dump");
+        }
+        if (args.length == 2 && ("aggressive".equalsIgnoreCase(args[0]) || "capability".equalsIgnoreCase(args[0])))
+        {
+            return getListOfStringsMatchingLastWord(args, "on", "off");
+        }
+        return Collections.emptyList();
+    }
+}
diff --git a/net/minecraftforge/common/memory/MemoryLeakGuard.java b/net/minecraftforge/common/memory/MemoryLeakGuard.java
new file mode 100644
index 0000000..ce5e4d6
--- /dev/null
+++ b/net/minecraftforge/common/memory/MemoryLeakGuard.java
@@ -0,0 +1,308 @@
+/*
+ * Minecraft Forge
+ * Copyright (c) 2016-2020.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation version 2.1
+ * of the License.
+ */
+
+package net.minecraftforge.common.memory;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.PrintWriter;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicLong;
+
+import net.minecraft.world.World;
+import net.minecraftforge.common.DimensionManager;
+import net.minecraftforge.common.FarmlandWaterManager;
+import net.minecraftforge.common.chunkio.ChunkIOExecutor;
+import net.minecraftforge.common.threading.ClientSimulationThread;
+import net.minecraftforge.common.threading.IC2ExplosionSync;
+import net.minecraftforge.common.threading.PregenManager;
+import net.minecraftforge.common.threading.RegionManager;
+
+/**
+ * World-reference firewall and heap watchdog.
+ *
+ * Forge 1.12.2 has several static holders that key on a World (or keep a strong world reference). Most are weak,
+ * but the fork's own region/chunk-IO/client-simulation structures are not, and mods routinely keep static maps of
+ * worlds/chunks/tickets. When a dimension unloads, those references prevent the World, its chunks, its
+ * TileEntities and all of their capability providers from being collected. The player sees this as RAM usage that
+ * only grows across world reloads / dimension unloads until a freeze or OOM.
+ *
+ * On WorldEvent.Unload we sever the known strong references immediately, arm the capability weak-audit for that
+ * dimension, and (opt-in) sweep mod static collections for the dead world. A server-tick watchdog samples the heap
+ * and reports survivors. None of this touches a live world.
+ *
+ * Properties:
+ *   -Dforge.memory.watchdog=true             enable the periodic heap/leak audit (default true)
+ *   -Dforge.memory.auditIntervalTicks=1200   audit period (60 s at 20 tps)
+ *   -Dforge.memory.heapWarnPercent=88        log a warning above this used-heap percentage
+ *   -Dforge.memory.aggressivePurge=false     reflectively purge mod static maps on world unload
+ *   -Dforge.memory.capabilityAudit=true      track world-bound capability owners with weak references
+ */
+public final class MemoryLeakGuard
+{
+    private static final org.apache.logging.log4j.Logger LOGGER = org.apache.logging.log4j.LogManager.getLogger("ForgeMemory");
+    private static final boolean WATCHDOG = Boolean.parseBoolean(System.getProperty("forge.memory.watchdog", "true"));
+    private static final int AUDIT_INTERVAL = Math.max(20, Integer.getInteger("forge.memory.auditIntervalTicks", 1200).intValue());
+    private static final int HEAP_WARN = Math.max(50, Math.min(99, Integer.getInteger("forge.memory.heapWarnPercent", 88).intValue()));
+
+    private static final boolean VERBOSE_AUDIT = Boolean.parseBoolean(System.getProperty("forge.memory.verboseAudit", "false"));
+    private static final AtomicBoolean AGGRESSIVE = new AtomicBoolean(Boolean.parseBoolean(System.getProperty("forge.memory.aggressivePurge", "false")));
+    private static final AtomicLong UNLOADS = new AtomicLong();
+    private static final AtomicLong PURGED = new AtomicLong();
+    private static final AtomicLong AUDITS = new AtomicLong();
+    private static final AtomicLong WARNINGS = new AtomicLong();
+    private static volatile int tickCounter;
+    private static volatile long lastAuditMillis;
+
+    private MemoryLeakGuard()
+    {
+    }
+
+    public static boolean isAggressive()
+    {
+        return AGGRESSIVE.get();
+    }
+
+    public static void setAggressive(boolean aggressive)
+    {
+        AGGRESSIVE.set(aggressive);
+    }
+
+    public static void onWorldLoad(World world)
+    {
+        if (world == null || world.provider == null)
+        {
+            return;
+        }
+        CapabilityLeakTracker.onWorldLoad(world.provider.getDimension());
+    }
+
+    public static void onWorldUnload(World world)
+    {
+        if (world == null)
+        {
+            return;
+        }
+
+        int dimension = world.provider == null ? Integer.MIN_VALUE : world.provider.getDimension();
+        long removed = 0L;
+
+        removed += safeCount("region-owners", () -> RegionManager.clearEntityOwners(world));
+        removed += safeCount("chunkio", () -> ChunkIOExecutor.purgeWorld(world));
+        removed += safeCount("chunkgen", () -> net.minecraftforge.common.threading.ChunkGenExecutor.purgeWorld(world));
+        if (world.provider != null)
+        {
+            removed += safeCount("farmland", () -> FarmlandWaterManager.purgeDimension(dimension));
+        }
+        removed += safeCount("client-sim", () -> ClientSimulationThread.clearWorld(world));
+        removed += safeCount("pregen", () -> PregenManager.clearWorld(world));
+        removed += safeCount("ic2-explosions", () -> IC2ExplosionSync.clearWorld(world));
+
+        CapabilityLeakTracker.onWorldUnload(dimension);
+
+        if (AGGRESSIVE.get())
+        {
+            removed += safeCount("mod-static", () -> ModReferencePurger.purge(world));
+        }
+
+        UNLOADS.incrementAndGet();
+        PURGED.addAndGet(removed);
+        LOGGER.info("[mem] world unload dim={} purged {} static reference(s)", Integer.valueOf(dimension),
+                Long.valueOf(removed));
+
+        if (AGGRESSIVE.get() && removed == 0L)
+        {
+            LOGGER.debug("[mem] aggressive purge found no references for dim {}; the leak may be in a holder "
+                    + "that is not a static Map/Collection/array in a mod class", Integer.valueOf(dimension));
+        }
+    }
+
+    public static void onServerTick()
+    {
+        if (!WATCHDOG)
+        {
+            return;
+        }
+        if (++tickCounter < AUDIT_INTERVAL)
+        {
+            return;
+        }
+        tickCounter = 0;
+        try
+        {
+            runAudit(true);
+        }
+        catch (Throwable throwable)
+        {
+            LOGGER.warn("[mem] audit failed", throwable);
+        }
+    }
+
+    public static List<String> audit()
+    {
+        List<String> lines = new ArrayList<String>();
+        Runtime runtime = Runtime.getRuntime();
+        long used = runtime.totalMemory() - runtime.freeMemory();
+        long max = runtime.maxMemory();
+        lines.add("[mem] heap " + megabytes(used) + " / " + megabytes(max) + " (" + percent(used, max) + "%)"
+                + " loadedWorlds=" + DimensionManager.getLoadedWorldCount()
+                + " leakedWorlds=" + DimensionManager.getLeakedWorldCount());
+        lines.add("[mem] unloads=" + UNLOADS.get() + " purged=" + PURGED.get() + " audits=" + AUDITS.get()
+                + " warnings=" + WARNINGS.get() + " aggressive=" + AGGRESSIVE.get()
+                + " capabilityAudit=" + CapabilityLeakTracker.isEnabled());
+        lines.add("[mem] regionTrackedWorlds=" + RegionManager.getTrackedWorldCount()
+                + " chunkioQueued=" + ChunkIOExecutor.getQueuedCount());
+        lines.addAll(CapabilityLeakTracker.report(8));
+        return lines;
+    }
+
+    private static void runAudit(boolean log)
+    {
+        AUDITS.incrementAndGet();
+        lastAuditMillis = System.currentTimeMillis();
+
+        Runtime runtime = Runtime.getRuntime();
+        long used = runtime.totalMemory() - runtime.freeMemory();
+        long max = runtime.maxMemory();
+        int percent = percent(used, max);
+
+        // getIDs(true) makes DimensionManager update its leaked-world counters and log suspicious worlds.
+        DimensionManager.getIDs(true);
+        int leaked = DimensionManager.getLeakedWorldCount();
+
+        boolean pressure = percent >= HEAP_WARN || leaked > 0;
+        if (pressure || VERBOSE_AUDIT)
+        {
+            List<String> lines = audit();
+            if (pressure)
+            {
+                WARNINGS.incrementAndGet();
+                LOGGER.warn("[mem] pressure detected ({}% heap, {} leaked world(s)); enabling /forgemem audit for details",
+                        Integer.valueOf(percent), Integer.valueOf(leaked));
+            }
+            if (log)
+            {
+                for (String line : lines)
+                {
+                    if (pressure)
+                    {
+                        LOGGER.warn(line);
+                    }
+                    else
+                    {
+                        LOGGER.info(line);
+                    }
+                }
+            }
+        }
+        else if (log)
+        {
+            LOGGER.debug("[mem] heap {} ({}%) loadedWorlds={} leakedWorlds={}",
+                    megabytes(used), Integer.valueOf(percent),
+                    Integer.valueOf(DimensionManager.getLoadedWorldCount()), Integer.valueOf(leaked));
+        }
+    }
+
+    public static List<String> purge()
+    {
+        int chunkio = ChunkIOExecutor.purgeCompleted();
+        DimensionManager.clearLeakTracking();
+        List<String> lines = new ArrayList<String>();
+        lines.add("[mem] purge complete: chunkioCompletedTasks=" + chunkio
+                + " leakTrackingCleared=true purgedTotal=" + PURGED.get());
+        lines.addAll(audit());
+        return lines;
+    }
+
+    public static List<String> gc()
+    {
+        Runtime runtime = Runtime.getRuntime();
+        long before = runtime.totalMemory() - runtime.freeMemory();
+        System.gc();
+        try
+        {
+            Thread.sleep(150L);
+        }
+        catch (InterruptedException interrupted)
+        {
+            Thread.currentThread().interrupt();
+        }
+        long after = runtime.totalMemory() - runtime.freeMemory();
+        List<String> lines = new ArrayList<String>();
+        lines.add("[mem] gc: used " + megabytes(before) + " -> " + megabytes(after)
+                + " (" + megabytes(Math.max(0L, before - after)) + " reclaimed)");
+        lines.addAll(audit());
+        return lines;
+    }
+
+    public static File writeDump() throws IOException
+    {
+        File file = new File("logs/forgemem-" + System.currentTimeMillis() + ".txt");
+        try (PrintWriter writer = new PrintWriter(file, "UTF-8"))
+        {
+            writer.println("Forge memory audit");
+            writer.println("time=" + lastAuditMillis);
+            for (String line : audit())
+            {
+                writer.println(line);
+            }
+        }
+        return file;
+    }
+
+    private static String megabytes(long bytes)
+    {
+        return String.format(java.util.Locale.ROOT, "%.1fMiB", Double.valueOf(bytes / 1048576.0D));
+    }
+
+    private static int percent(long used, long max)
+    {
+        return max <= 0L ? 0 : (int) Math.min(100L, (used * 100L) / max);
+    }
+
+    private interface PurgeAction
+    {
+        void run() throws Throwable;
+    }
+
+    private interface PurgeCount
+    {
+        int run() throws Throwable;
+    }
+
+    private static long safe(String name, PurgeAction action)
+    {
+        try
+        {
+            action.run();
+            return 0L;
+        }
+        catch (Throwable throwable)
+        {
+            LOGGER.warn("[mem] purge step '{}' failed", name, throwable);
+            return 0L;
+        }
+    }
+
+    private static long safeCount(String name, PurgeCount action)
+    {
+        try
+        {
+            return Math.max(0, action.run());
+        }
+        catch (Throwable throwable)
+        {
+            LOGGER.warn("[mem] purge step '{}' failed", name, throwable);
+            return 0L;
+        }
+    }
+}
diff --git a/net/minecraftforge/common/memory/ModReferencePurger.java b/net/minecraftforge/common/memory/ModReferencePurger.java
new file mode 100644
index 0000000..e82df38
--- /dev/null
+++ b/net/minecraftforge/common/memory/ModReferencePurger.java
@@ -0,0 +1,389 @@
+/*
+ * Minecraft Forge
+ * Copyright (c) 2016-2020.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation version 2.1
+ * of the License.
+ */
+
+package net.minecraftforge.common.memory;
+
+import java.io.File;
+import java.lang.reflect.Array;
+import java.lang.reflect.Field;
+import java.lang.reflect.Modifier;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Enumeration;
+import java.util.IdentityHashMap;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.jar.JarEntry;
+import java.util.jar.JarFile;
+
+import net.minecraft.entity.Entity;
+import net.minecraft.tileentity.TileEntity;
+import net.minecraft.world.World;
+import net.minecraft.world.chunk.Chunk;
+import net.minecraftforge.fml.common.Loader;
+import net.minecraftforge.fml.common.ModContainer;
+
+/**
+ * Opt-in reflective reference firewall for badly behaved mods.
+ *
+ * ChickenChunks/Energy-Control style leaks usually come from a static map in the mod that keeps the World, a
+ * Chunk, or a world-bound Ticket after the dimension unloads. We cannot enumerate every loaded class without a
+ * Java agent, but we can enumerate the classes of every active mod jar and inspect their static Map/Collection/
+ * array fields. On WorldEvent.Unload we remove entries whose key or value is the unloaded world (or an object
+ * whose direct field world/worldObj/level/dimension points at it).
+ *
+ * This is deliberately opt-in (-Dforge.memory.aggressivePurge=true or /forgemem aggressive on) and only touches
+ * classes loaded by the mod class loader, never Forge/vanilla classes (those are purged explicitly elsewhere).
+ * Every removal is logged so a bad interaction can be diagnosed.
+ */
+public final class ModReferencePurger
+{
+    private static final org.apache.logging.log4j.Logger LOGGER = org.apache.logging.log4j.LogManager.getLogger("ForgeMemory");
+    private static final int MAX_CLASSES = Integer.getInteger("forge.memory.maxScannedClasses", 200000).intValue();
+    private static final long MAX_ENTRIES = Long.getLong("forge.memory.maxScannedEntries", 5000000L).longValue();
+    private static final Set<String> WORLD_FIELD_NAMES = ConcurrentHashMap.newKeySet();
+    private static final Map<Class<?>, Field[]> WORLD_FIELD_CACHE = new ConcurrentHashMap<Class<?>, Field[]>();
+
+    static
+    {
+        WORLD_FIELD_NAMES.add("world");
+        WORLD_FIELD_NAMES.add("worldObj");
+        WORLD_FIELD_NAMES.add("level");
+        WORLD_FIELD_NAMES.add("dimension");
+        WORLD_FIELD_NAMES.add("worldServer");
+        WORLD_FIELD_NAMES.add("targetWorld");
+    }
+
+    private ModReferencePurger()
+    {
+    }
+
+    public static int purge(World world)
+    {
+        if (world == null || !MemoryLeakGuard.isAggressive())
+        {
+            return 0;
+        }
+
+        final ClassLoader modLoader = Loader.instance().getModClassLoader();
+        if (modLoader == null)
+        {
+            return 0;
+        }
+
+        int removed = 0;
+        long examined = 0L;
+        long start = System.nanoTime();
+        int classes = 0;
+        int scanned = 0;
+
+        for (ModContainer mod : Loader.instance().getActiveModList())
+        {
+            File source = mod.getSource();
+            if (source == null)
+            {
+                continue;
+            }
+            List<String> names = classNames(source);
+            classes += names.size();
+            for (String className : names)
+            {
+                if (scanned++ >= MAX_CLASSES)
+                {
+                    LOGGER.warn("[mem][aggressive] class scan cap reached ({}), stopping", Integer.valueOf(MAX_CLASSES));
+                    break;
+                }
+                try
+                {
+                    Class<?> type = Class.forName(className, false, modLoader);
+                    if (type.getClassLoader() != modLoader)
+                    {
+                        continue;
+                    }
+                    long limit = MAX_ENTRIES - examined;
+                    if (limit <= 0L)
+                    {
+                        LOGGER.warn("[mem][aggressive] entry scan cap reached ({}), stopping", Long.valueOf(MAX_ENTRIES));
+                        break;
+                    }
+                    PurgeResult result = purgeClass(type, world, limit);
+                    removed += result.removed;
+                    examined += result.examined;
+                }
+                catch (Throwable ignored)
+                {
+                    // Missing optional dependency, exotic class loader, etc. Not our problem.
+                }
+            }
+        }
+
+        if (removed > 0)
+        {
+            LOGGER.warn("[mem][aggressive] removed {} static references to unloaded world ({} classes, {} entries, {} ms)",
+                    Integer.valueOf(removed), Integer.valueOf(scanned), Long.valueOf(examined),
+                    Long.valueOf((System.nanoTime() - start) / 1000000L));
+        }
+        else
+        {
+            LOGGER.debug("[mem][aggressive] no mod static references to unloaded world ({} classes scanned)",
+                    Integer.valueOf(scanned));
+        }
+        return removed;
+    }
+
+    private static PurgeResult purgeClass(Class<?> type, World world, long limit)
+    {
+        PurgeResult result = new PurgeResult();
+        Field[] fields = type.getDeclaredFields();
+        for (Field field : fields)
+        {
+            int modifiers = field.getModifiers();
+            if (!Modifier.isStatic(modifiers) || field.isSynthetic())
+            {
+                continue;
+            }
+            Class<?> fieldType = field.getType();
+            boolean isMap = Map.class.isAssignableFrom(fieldType);
+            boolean isCollection = Collection.class.isAssignableFrom(fieldType);
+            if (!isMap && !isCollection && !fieldType.isArray())
+            {
+                continue;
+            }
+
+            Object value;
+            try
+            {
+                field.setAccessible(true);
+                value = field.get(null);
+            }
+            catch (Throwable ignored)
+            {
+                continue;
+            }
+            if (value == null)
+            {
+                continue;
+            }
+
+            int removed = purgeValue(value, world, limit - result.examined);
+            if (removed > 0)
+            {
+                result.removed += removed;
+                LOGGER.warn("[mem][aggressive] {}.{}: removed {} reference(s) to unloaded world",
+                        type.getName(), field.getName(), Integer.valueOf(removed));
+            }
+            result.examined += Math.max(removed, 1);
+        }
+        return result;
+    }
+
+    private static int purgeValue(Object value, World world, long limit)
+    {
+        if (limit <= 0L)
+        {
+            return 0;
+        }
+        int removed = 0;
+        try
+        {
+            if (value instanceof Map)
+            {
+                Iterator<? extends Map.Entry<?, ?>> iterator = ((Map<?, ?>) value).entrySet().iterator();
+                while (iterator.hasNext())
+                {
+                    Map.Entry<?, ?> entry = iterator.next();
+                    if (matches(entry.getKey(), world) || matches(entry.getValue(), world))
+                    {
+                        iterator.remove();
+                        removed++;
+                    }
+                }
+            }
+            else if (value instanceof Collection)
+            {
+                Iterator<?> iterator = ((Collection<?>) value).iterator();
+                while (iterator.hasNext())
+                {
+                    if (matches(iterator.next(), world))
+                    {
+                        iterator.remove();
+                        removed++;
+                    }
+                }
+            }
+            else if (value.getClass().isArray() && !value.getClass().getComponentType().isPrimitive())
+            {
+                int length = Array.getLength(value);
+                for (int index = 0; index < length; index++)
+                {
+                    if (matches(Array.get(value, index), world))
+                    {
+                        Array.set(value, index, null);
+                        removed++;
+                    }
+                }
+            }
+        }
+        catch (UnsupportedOperationException ignored)
+        {
+            // Immutable view; nothing we can do without replacing the field.
+        }
+        catch (Throwable ignored)
+        {
+            // Concurrent modification in a mod map or a hostile collection implementation.
+        }
+        return removed;
+    }
+
+    private static boolean matches(Object candidate, World world)
+    {
+        if (candidate == null)
+        {
+            return false;
+        }
+        if (candidate == world)
+        {
+            return true;
+        }
+        if (candidate instanceof Class || candidate instanceof ClassLoader || candidate instanceof String)
+        {
+            return false;
+        }
+        try
+        {
+            if (candidate instanceof Chunk)
+            {
+                return ((Chunk) candidate).getWorld() == world;
+            }
+            if (candidate instanceof TileEntity)
+            {
+                return ((TileEntity) candidate).getWorld() == world;
+            }
+            if (candidate instanceof Entity)
+            {
+                return ((Entity) candidate).world == world;
+            }
+            for (Field field : worldFields(candidate.getClass()))
+            {
+                Object referenced;
+                try
+                {
+                    referenced = field.get(candidate);
+                }
+                catch (Throwable ignored)
+                {
+                    continue;
+                }
+                if (referenced == world)
+                {
+                    return true;
+                }
+            }
+        }
+        catch (Throwable ignored)
+        {
+        }
+        return false;
+    }
+
+    private static Field[] worldFields(Class<?> type)
+    {
+        Field[] cached = WORLD_FIELD_CACHE.get(type);
+        if (cached != null)
+        {
+            return cached;
+        }
+        List<Field> fields = new ArrayList<Field>();
+        for (Field field : type.getDeclaredFields())
+        {
+            if (Modifier.isStatic(field.getModifiers()) || field.getType().isPrimitive())
+            {
+                continue;
+            }
+            if (!WORLD_FIELD_NAMES.contains(field.getName()))
+            {
+                continue;
+            }
+            try
+            {
+                field.setAccessible(true);
+                fields.add(field);
+            }
+            catch (Throwable ignored)
+            {
+            }
+        }
+        Field[] result = fields.toArray(new Field[fields.size()]);
+        WORLD_FIELD_CACHE.put(type, result);
+        return result;
+    }
+
+    private static List<String> classNames(File source)
+    {
+        List<String> result = new ArrayList<String>();
+        try
+        {
+            if (source.isDirectory())
+            {
+                collectDirectory(source.toPath(), source.toPath(), result);
+            }
+            else if (source.isFile())
+            {
+                try (JarFile jar = new JarFile(source))
+                {
+                    Enumeration<JarEntry> entries = jar.entries();
+                    while (entries.hasMoreElements())
+                    {
+                        String name = entries.nextElement().getName();
+                        if (name.endsWith(".class") && !name.startsWith("META-INF/"))
+                        {
+                            result.add(name.substring(0, name.length() - 6).replace('/', '.'));
+                        }
+                    }
+                }
+            }
+        }
+        catch (Throwable ignored)
+        {
+        }
+        return result;
+    }
+
+    private static void collectDirectory(Path root, Path directory, List<String> result)
+    {
+        File[] files = directory.toFile().listFiles();
+        if (files == null)
+        {
+            return;
+        }
+        for (File file : files)
+        {
+            if (file.isDirectory())
+            {
+                collectDirectory(root, file.toPath(), result);
+            }
+            else if (file.getName().endsWith(".class"))
+            {
+                String relative = root.relativize(file.toPath()).toString().replace(File.separatorChar, '/');
+                result.add(relative.substring(0, relative.length() - 6).replace('/', '.'));
+            }
+        }
+    }
+
+    private static final class PurgeResult
+    {
+        private int removed;
+        private long examined;
+    }
+}
diff --git a/net/minecraftforge/common/threading/BackgroundPacer.java b/net/minecraftforge/common/threading/BackgroundPacer.java
new file mode 100644
index 0000000..4ac7239
--- /dev/null
+++ b/net/minecraftforge/common/threading/BackgroundPacer.java
@@ -0,0 +1,174 @@
+/*
+ * Minecraft Forge
+ * Copyright (c) 2016-2020.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation version 2.1
+ * of the License.
+ */
+
+package net.minecraftforge.common.threading;
+
+import java.util.List;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.concurrent.locks.LockSupport;
+
+/**
+ * MSPT airbag.
+ *
+ * <p>The 1.12.2 client and the integrated server share one JVM. A client frame that spends a lot of CPU inside
+ * the chunk compiler, the render-prep thread or the packet pipeline does not only drop frames: it steals the CPU
+ * slice that the server thread needs, and the next server tick is reported as a multi-hundred-millisecond spike.
+ * The usual reaction is to lower the number of background threads, which permanently reduces throughput.
+ *
+ * <p>This class implements a feedback loop instead. Game threads publish the duration of every tick/frame. When a
+ * game thread recently overshot its budget, background pools voluntarily park for a very short slice before starting
+ * the next work item. The background work is not cancelled and no queue is dropped - it simply yields the CPU
+ * exactly while the game thread needs it, then resumes at full speed. In steady state (no over-budget tick) the
+ * check is one volatile read and has no measurable cost.
+ *
+ * <p>Disable with {@code -Dforge.threading.pacer=false}. Tunables:
+ * <ul>
+ *   <li>{@code -Dforge.threading.pacer.serverBudgetMs} (default 35)</li>
+ *   <li>{@code -Dforge.threading.pacer.clientBudgetMs} (default 50)</li>
+ *   <li>{@code -Dforge.threading.pacer.holdMs} (default 200)</li>
+ *   <li>{@code -Dforge.threading.pacer.sliceUs} (default 250)</li>
+ * </ul>
+ */
+public final class BackgroundPacer
+{
+    private static final boolean ENABLED = Boolean.parseBoolean(System.getProperty("forge.threading.pacer", "true"));
+    private static final long SERVER_BUDGET_NANOS = millisToNanos(
+            Long.getLong("forge.threading.pacer.serverBudgetMs", 35L).longValue());
+    private static final long CLIENT_BUDGET_NANOS = millisToNanos(
+            Long.getLong("forge.threading.pacer.clientBudgetMs", 50L).longValue());
+    private static final long HOLD_NANOS = millisToNanos(
+            Long.getLong("forge.threading.pacer.holdMs", 200L).longValue());
+    private static final long SLICE_NANOS = Math.max(50000L, Long.getLong("forge.threading.pacer.sliceUs", 250L).longValue() * 1000L);
+    /** Upper bound for the feedback hold; an ancient stall must not throttle the rest of the session. */
+    private static final long MAX_HOLD_NANOS = millisToNanos(500L);
+
+    private static volatile long serverHoldUntil;
+    private static volatile long clientHoldUntil;
+    private static volatile long lastServerTickNanos;
+    private static volatile long lastClientFrameNanos;
+
+    private static final AtomicLong YIELDS = new AtomicLong();
+    private static final AtomicLong YIELD_NANOS = new AtomicLong();
+    private static final AtomicLong SERVER_OVERRUNS = new AtomicLong();
+    private static final AtomicLong CLIENT_OVERRUNS = new AtomicLong();
+
+    private BackgroundPacer()
+    {
+    }
+
+    public static boolean isEnabled()
+    {
+        return ENABLED;
+    }
+
+    private static long millisToNanos(long millis)
+    {
+        return Math.max(0L, millis) * 1000000L;
+    }
+
+    /** Called from the server thread after every measured world tick. */
+    public static void noteServerTick(long nanos)
+    {
+        if (!ENABLED || nanos < 0L)
+        {
+            return;
+        }
+        lastServerTickNanos = nanos;
+        if (nanos > SERVER_BUDGET_NANOS)
+        {
+            SERVER_OVERRUNS.incrementAndGet();
+            serverHoldUntil = System.nanoTime() + Math.min(MAX_HOLD_NANOS, HOLD_NANOS);
+        }
+    }
+
+    /** Called from the client thread after every rendered frame. */
+    public static void noteClientFrame(long nanos)
+    {
+        if (!ENABLED || nanos < 0L)
+        {
+            return;
+        }
+        lastClientFrameNanos = nanos;
+        if (nanos > CLIENT_BUDGET_NANOS)
+        {
+            CLIENT_OVERRUNS.incrementAndGet();
+            clientHoldUntil = System.nanoTime() + Math.min(MAX_HOLD_NANOS, HOLD_NANOS);
+        }
+    }
+
+    public static boolean isHolding()
+    {
+        if (!ENABLED)
+        {
+            return false;
+        }
+        long now = System.nanoTime();
+        return now < serverHoldUntil || now < clientHoldUntil;
+    }
+
+    /**
+     * Called by background workers immediately before a work item. Returns immediately unless a game thread recently
+     * overran its budget; then parks for one short slice so the scheduler has a chance to run the game thread.
+     */
+    public static void yieldIfNeeded()
+    {
+        yieldIfNeeded(false);
+    }
+
+    /**
+     * @param ignoreServerHold when true, a server-thread overrun does not park this worker. Client chunk builders
+     *                         must keep building/uploading visible chunks even while the integrated server is
+     *                         briefly over budget: the server TPS is already 20 and the renderer is the actual
+     *                         bottleneck. The client hold is still honoured.
+     */
+    public static void yieldIfNeeded(boolean ignoreServerHold)
+    {
+        if (!ENABLED)
+        {
+            return;
+        }
+        long now = System.nanoTime();
+        long until = ignoreServerHold ? clientHoldUntil : Math.max(serverHoldUntil, clientHoldUntil);
+        if (until <= now)
+        {
+            return;
+        }
+        long slice = Math.min(until - now, SLICE_NANOS);
+        if (slice > 0L)
+        {
+            LockSupport.parkNanos(slice);
+            YIELDS.incrementAndGet();
+            YIELD_NANOS.addAndGet(slice);
+        }
+    }
+
+    public static void appendOverlayLines(List<String> lines)
+    {
+        if (!ENABLED)
+        {
+            return;
+        }
+        lines.add(String.format(java.util.Locale.ROOT,
+                "[Pacer] hold=%s serverLast=%.2fms clientLast=%.2fms yields=%d serverOver=%d clientOver=%d",
+                Boolean.valueOf(isHolding()), Double.valueOf(lastServerTickNanos / 1000000.0D),
+                Double.valueOf(lastClientFrameNanos / 1000000.0D), Long.valueOf(YIELDS.get()),
+                Long.valueOf(SERVER_OVERRUNS.get()), Long.valueOf(CLIENT_OVERRUNS.get())));
+    }
+
+    public static long getYieldCount()
+    {
+        return YIELDS.get();
+    }
+
+    public static long getYieldNanos()
+    {
+        return YIELD_NANOS.get();
+    }
+}
diff --git a/net/minecraftforge/common/threading/ChunkGenExecutor.java b/net/minecraftforge/common/threading/ChunkGenExecutor.java
new file mode 100644
index 0000000..0d70d1d
--- /dev/null
+++ b/net/minecraftforge/common/threading/ChunkGenExecutor.java
@@ -0,0 +1,692 @@
+/*
+ * Minecraft Forge
+ * Copyright (c) 2016-2020.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation version 2.1
+ * of the License.
+ */
+
+package net.minecraftforge.common.threading;
+
+import java.util.Iterator;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ConcurrentLinkedQueue;
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.concurrent.PriorityBlockingQueue;
+import java.util.concurrent.ThreadFactory;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.concurrent.locks.ReentrantLock;
+import net.minecraft.util.math.ChunkPos;
+import net.minecraft.world.World;
+import net.minecraft.world.chunk.Chunk;
+import net.minecraft.world.gen.ChunkGeneratorOverworld;
+import net.minecraft.world.gen.ChunkProviderServer;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+/**
+ * Single-worker, out-of-tick chunk generation for the overworld generator.
+ *
+ * <p>The 1.12.2 overworld generator keeps mutable scratch state ({@code rand}, height/depth buffers,
+ * {@code biomesForGeneration}) and its structure generators keep caches. Running two generations at once corrupts
+ * that state, and running a generation on the server thread turns a chunk border into a 50-200 ms tick. This class
+ * therefore serialises every generator call behind {@link #worldGenLock()}:
+ *
+ * <ul>
+ *   <li>one background worker generates {@link net.minecraft.world.gen.IChunkGenerator#generateChunk(int, int)};</li>
+ *   <li>the main thread commits the finished chunk and posts its {@code populate} to a bounded per-tick pump;</li>
+ *   <li>the pump uses {@code tryLock}: if the worker is mid-generation the populate is retried next tick instead of
+ *       blocking the server thread;</li>
+ *   <li>the old synchronous path still takes the same lock, so a {@code World#getChunk} request can never race the
+ *       worker.</li>
+ * </ul>
+ *
+ * <p>Only the vanilla overworld generator is offloaded. Modded/replaced generators keep the synchronous path
+ * because their thread-safety cannot be verified from here.
+ *
+ * <p>Disable with {@code -Dforge.threading.asyncChunkGen=false}. Tunables:
+ * {@code forge.threading.chunkGenThreads} (default 1), {@code forge.threading.chunkGenQueue} (512),
+ * {@code forge.threading.chunkPostBudgetMs} (8), {@code forge.threading.chunkPostPerTick} (2).
+ */
+public final class ChunkGenExecutor
+{
+    private static final Logger LOGGER = LogManager.getLogger("ForgeThreading");
+
+    private static final boolean ENABLED = !Threading.isSingleThreaded() &&
+            Boolean.parseBoolean(System.getProperty("forge.threading.asyncChunkGen", "true"));
+    private static final int THREADS = Math.max(1, Integer.getInteger("forge.threading.chunkGenThreads", 1).intValue());
+    private static final int MAX_PENDING = Math.max(64, Integer.getInteger("forge.threading.chunkGenQueue", 512).intValue());
+    private static final long POST_BUDGET_NS = TimeUnit.MILLISECONDS.toNanos(
+            Math.max(1L, Long.getLong("forge.threading.chunkPostBudgetMs", 8L).longValue()));
+    private static final int POST_PER_TICK = Math.max(1, Integer.getInteger("forge.threading.chunkPostPerTick", 2).intValue());
+    private static final int HARVEST_PER_TICK = Math.max(1, Integer.getInteger("forge.threading.chunkHarvestPerTick", 4).intValue());
+
+    /** Guards every call into the overworld generator (generation and populate). */
+    private static final ReentrantLock WORLDGEN = new ReentrantLock();
+
+    private static final ConcurrentHashMap<GenKey, GenTask> TASKS = new ConcurrentHashMap<GenKey, GenTask>();
+    private static final ConcurrentLinkedQueue<PostTask> POSTS = new ConcurrentLinkedQueue<PostTask>();
+
+    private static final AtomicLong SEQUENCE = new AtomicLong();
+    private static final AtomicLong SUBMITTED = new AtomicLong();
+    private static final AtomicLong GENERATED = new AtomicLong();
+    private static final AtomicLong POSTED = new AtomicLong();
+    private static final AtomicLong POST_DONE = new AtomicLong();
+    private static final AtomicLong POST_DEFERRED = new AtomicLong();
+    private static final AtomicLong DROPPED = new AtomicLong();
+    private static final AtomicLong FAILED = new AtomicLong();
+
+    private static final ThreadPoolExecutor POOL;
+
+    static
+    {
+        ThreadFactory factory = new ThreadFactory()
+        {
+            private final AtomicInteger count = new AtomicInteger(1);
+
+            @Override
+            public Thread newThread(Runnable runnable)
+            {
+                Thread thread = new Thread(runnable, "Chunk Gen Worker-" + this.count.getAndIncrement());
+                thread.setDaemon(true);
+                thread.setPriority(Thread.NORM_PRIORITY - 1);
+                return thread;
+            }
+        };
+        POOL = new ThreadPoolExecutor(THREADS, THREADS, 30L, TimeUnit.SECONDS,
+                new PriorityBlockingQueue<Runnable>(), factory);
+        POOL.allowCoreThreadTimeOut(true);
+        ThreadingTelemetry.registerPool("chunkgen", POOL);
+    }
+
+    private ChunkGenExecutor()
+    {
+    }
+
+    public static boolean isEnabled()
+    {
+        return ENABLED;
+    }
+
+    /**
+     * True when this provider can be generated on the worker. The vanilla overworld generator is the only one whose
+     * state model has been audited; everything else must keep the synchronous path.
+     */
+    public static boolean supports(ChunkProviderServer provider)
+    {
+        return ENABLED && provider != null && provider.world != null && !provider.world.isRemote
+                && provider.chunkGenerator != null
+                && provider.chunkGenerator.getClass() == ChunkGeneratorOverworld.class;
+    }
+
+    public static boolean isPending(ChunkProviderServer provider, int x, int z)
+    {
+        return ENABLED && provider != null && TASKS.containsKey(new GenKey(provider, x, z));
+    }
+
+    public static void addCallback(ChunkProviderServer provider, int x, int z, Runnable callback)
+    {
+        if (callback == null || provider == null)
+        {
+            return;
+        }
+        GenTask task = TASKS.get(new GenKey(provider, x, z));
+        if (task != null)
+        {
+            task.callbacks.add(callback);
+        }
+    }
+
+    /**
+     * Queues a chunk for out-of-tick generation. Returns true when the chunk is now owned by the executor (queued,
+     * already generating or already queued). Returns false when async generation is unavailable and the caller must
+     * use the synchronous path.
+     */
+    public static boolean submit(ChunkProviderServer provider, int x, int z, Runnable callback, int priority, boolean unloadWhenDone)
+    {
+        if (!supports(provider))
+        {
+            return false;
+        }
+
+        GenKey key = new GenKey(provider, x, z);
+        GenTask existing = TASKS.get(key);
+        if (existing != null)
+        {
+            if (callback != null)
+            {
+                existing.callbacks.add(callback);
+            }
+            return true;
+        }
+
+        // Live player requests (priority 0) are never dropped: the player chunk map already rate-limits submissions.
+        // The cap only protects against a runaway pregen queue.
+        if (priority >= 50 && TASKS.size() >= MAX_PENDING)
+        {
+            DROPPED.incrementAndGet();
+            return false;
+        }
+
+        GenTask task = new GenTask(key, x, z, priority, unloadWhenDone);
+        if (callback != null)
+        {
+            task.callbacks.add(callback);
+        }
+
+        GenTask raced = TASKS.putIfAbsent(key, task);
+        if (raced != null)
+        {
+            if (callback != null)
+            {
+                raced.callbacks.add(callback);
+            }
+            return true;
+        }
+
+        SUBMITTED.incrementAndGet();
+        try
+        {
+            POOL.execute(task);
+        }
+        catch (Throwable throwable)
+        {
+            TASKS.remove(key, task);
+            FAILED.incrementAndGet();
+            LOGGER.error("[chunkgen] could not queue chunk ({}, {})", Integer.valueOf(x), Integer.valueOf(z), throwable);
+            return false;
+        }
+        return true;
+    }
+
+    /** Removes one callback; the task is cancelled when nobody is waiting for it anymore. */
+    public static void drop(ChunkProviderServer provider, int x, int z, Runnable callback)
+    {
+        if (provider == null)
+        {
+            return;
+        }
+        GenKey key = new GenKey(provider, x, z);
+        GenTask task = TASKS.get(key);
+        if (task == null)
+        {
+            return;
+        }
+        if (callback != null)
+        {
+            task.callbacks.remove(callback);
+        }
+        if (task.callbacks.isEmpty() && !task.unloadWhenDone)
+        {
+            task.cancelled = true;
+            if (POOL.remove(task))
+            {
+                TASKS.remove(key, task);
+                DROPPED.incrementAndGet();
+            }
+        }
+    }
+
+    /**
+     * Takes ownership of a queued/running generation for the synchronous path. If the task has not started yet it is
+     * run inline; otherwise the caller waits for the worker. The caller must commit the chunk and run populate under
+     * {@link #lockWorldGen()}.
+     */
+    public static Chunk awaitPending(ChunkProviderServer provider, int x, int z)
+    {
+        if (!ENABLED || provider == null)
+        {
+            return null;
+        }
+
+        GenKey key = new GenKey(provider, x, z);
+        GenTask task = TASKS.get(key);
+        if (task == null)
+        {
+            return null;
+        }
+
+        if (POOL.remove(task))
+        {
+            task.runInline();
+        }
+
+        synchronized (task)
+        {
+            long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(60L);
+            while (!task.done)
+            {
+                long remaining = deadline - System.nanoTime();
+                if (remaining <= 0L)
+                {
+                    break;
+                }
+                try
+                {
+                    task.wait(Math.max(1L, Math.min(25L, TimeUnit.NANOSECONDS.toMillis(remaining) + 1L)));
+                }
+                catch (InterruptedException interrupted)
+                {
+                    Thread.currentThread().interrupt();
+                    break;
+                }
+            }
+        }
+
+        if (!task.done || !TASKS.remove(key, task))
+        {
+            return null;
+        }
+        if (task.cancelled)
+        {
+            task.runCallbacks();
+            return null;
+        }
+        if (task.error != null)
+        {
+            FAILED.incrementAndGet();
+            LOGGER.error("[chunkgen] chunk ({}, {}) failed", Integer.valueOf(x), Integer.valueOf(z), task.error);
+            task.runCallbacks();
+            return null;
+        }
+
+        // The synchronous caller owns finalisation (commit + populate); release the entry/request callbacks now.
+        task.runCallbacks();
+        return task.chunk;
+    }
+
+    /** Posts the world-touching half (recreate structures + populate) of a loaded or generated chunk. */
+    public static void post(ChunkProviderServer provider, Chunk chunk, boolean recreateStructures)
+    {
+        post(provider, chunk, recreateStructures, null);
+    }
+
+    /**
+     * Same as {@link #post(ChunkProviderServer, Chunk, boolean)} and runs {@code after} once the chunk has been
+     * fully populated. Used to delay the player-map callback until the chunk is safe to send.
+     */
+    public static void post(ChunkProviderServer provider, Chunk chunk, boolean recreateStructures, Runnable after)
+    {
+        if (provider == null || chunk == null)
+        {
+            if (after != null)
+            {
+                after.run();
+            }
+            return;
+        }
+        if (!ENABLED)
+        {
+            provider.postProcessChunk(chunk, recreateStructures);
+            if (after != null)
+            {
+                after.run();
+            }
+            return;
+        }
+        POSTS.add(new PostTask(provider, chunk, recreateStructures, after));
+        POSTED.incrementAndGet();
+    }
+
+    /** Called once per server tick, on the server thread, before the world tick. */
+    public static void tick()
+    {
+        if (!ENABLED)
+        {
+            return;
+        }
+
+        // 1. Commit completed generations: loadedChunks.put + onLoad on the owning thread.
+        int harvested = 0;
+        for (Iterator<Map.Entry<GenKey, GenTask>> iterator = TASKS.entrySet().iterator(); iterator.hasNext(); )
+        {
+            Map.Entry<GenKey, GenTask> entry = iterator.next();
+            GenTask task = entry.getValue();
+            if (!task.done || !TASKS.remove(entry.getKey(), task))
+            {
+                continue;
+            }
+
+            if (task.error != null)
+            {
+                FAILED.incrementAndGet();
+                LOGGER.error("[chunkgen] chunk ({}, {}) failed", Integer.valueOf(task.x), Integer.valueOf(task.z), task.error);
+            }
+            else if (!task.cancelled)
+            {
+                try
+                {
+                    task.key.provider.acceptAsyncGeneratedChunk(task.x, task.z, task.chunk);
+                    if (task.unloadWhenDone)
+                    {
+                        // Pregen: persist the terrain and drop it immediately. Running populate here would spawn
+                        // world-gen animals and generate features for chunks nobody is near yet, which then tick
+                        // in the region workers until the unload budget catches up.
+                        task.key.provider.unloadGeneratedChunk(task.chunk);
+                    }
+                    else
+                    {
+                        // Notify the requester only after populate; otherwise a loaded chunk could be sent before
+                        // recreateStructures/generateStructures has run.
+                        post(task.key.provider, task.chunk, false, task::runCallbacks);
+                    }
+                    GENERATED.incrementAndGet();
+                }
+                catch (Throwable throwable)
+                {
+                    FAILED.incrementAndGet();
+                    LOGGER.error("[chunkgen] could not commit chunk ({}, {})", Integer.valueOf(task.x), Integer.valueOf(task.z), throwable);
+                }
+            }
+
+            if (task.error != null || task.cancelled || task.unloadWhenDone)
+            {
+                task.runCallbacks();
+            }
+            if (++harvested >= HARVEST_PER_TICK)
+            {
+                break;
+            }
+        }
+
+        // 2. Bounded populate pump. Never blocks the server thread on the generator lock.
+        long deadline = System.nanoTime() + POST_BUDGET_NS;
+        int done = 0;
+        while (done < POST_PER_TICK)
+        {
+            PostTask post = POSTS.peek();
+            if (post == null)
+            {
+                break;
+            }
+            if (System.nanoTime() >= deadline)
+            {
+                POST_DEFERRED.incrementAndGet();
+                break;
+            }
+            if (!WORLDGEN.tryLock())
+            {
+                POST_DEFERRED.incrementAndGet();
+                break;
+            }
+            boolean processed = false;
+            try
+            {
+                if (!POSTS.remove(post))
+                {
+                    continue;
+                }
+                try
+                {
+                    post.provider.postProcessChunk(post.chunk, post.recreateStructures);
+                    POST_DONE.incrementAndGet();
+                    ++done;
+                    processed = true;
+                }
+                catch (Throwable throwable)
+                {
+                    FAILED.incrementAndGet();
+                    LOGGER.error("[chunkgen] post-process failed", throwable);
+                }
+            }
+            finally
+            {
+                WORLDGEN.unlock();
+            }
+            if (processed && post.after != null)
+            {
+                try
+                {
+                    post.after.run();
+                }
+                catch (Throwable throwable)
+                {
+                    FAILED.incrementAndGet();
+                    LOGGER.error("[chunkgen] post callback failed", throwable);
+                }
+            }
+        }
+    }
+
+    /** The caller must release the lock in a finally block. */
+    public static void lockWorldGen()
+    {
+        if (ENABLED)
+        {
+            WORLDGEN.lock();
+        }
+    }
+
+    public static void unlockWorldGen()
+    {
+        if (ENABLED)
+        {
+            WORLDGEN.unlock();
+        }
+    }
+
+    public static boolean isWorldGenLockedByCurrentThread()
+    {
+        return ENABLED && WORLDGEN.isHeldByCurrentThread();
+    }
+
+    public static int purgeWorld(World world)
+    {
+        if (world == null)
+        {
+            return 0;
+        }
+
+        int removed = 0;
+        for (Iterator<Map.Entry<GenKey, GenTask>> iterator = TASKS.entrySet().iterator(); iterator.hasNext(); )
+        {
+            Map.Entry<GenKey, GenTask> entry = iterator.next();
+            if (entry.getKey().world() == world)
+            {
+                GenTask task = entry.getValue();
+                task.cancelled = true;
+                iterator.remove();
+                POOL.remove(task);
+                ++removed;
+            }
+        }
+        for (PostTask post : POSTS)
+        {
+            if (post.provider.world == world)
+            {
+                POSTS.remove(post);
+                ++removed;
+            }
+        }
+        return removed;
+    }
+
+    public static int getPendingCount()
+    {
+        return TASKS.size();
+    }
+
+    public static int getPostCount()
+    {
+        return POSTS.size();
+    }
+
+    public static long getGeneratedCount()
+    {
+        return GENERATED.get();
+    }
+
+    public static long getPostDeferredCount()
+    {
+        return POST_DEFERRED.get();
+    }
+
+    public static long getDroppedCount()
+    {
+        return DROPPED.get();
+    }
+
+    // ------------------------------------------------------------------
+
+    private static final class GenKey
+    {
+        private final ChunkProviderServer provider;
+        private final int x;
+        private final int z;
+        private final int hash;
+
+        private GenKey(ChunkProviderServer provider, int x, int z)
+        {
+            this.provider = provider;
+            this.x = x;
+            this.z = z;
+            this.hash = System.identityHashCode(provider) * 31 + (int)(ChunkPos.asLong(x, z) * 13L);
+        }
+
+        private World world()
+        {
+            return this.provider.world;
+        }
+
+        @Override
+        public int hashCode()
+        {
+            return this.hash;
+        }
+
+        @Override
+        public boolean equals(Object other)
+        {
+            if (!(other instanceof GenKey))
+            {
+                return false;
+            }
+            GenKey key = (GenKey)other;
+            return key.provider == this.provider && key.x == this.x && key.z == this.z;
+        }
+    }
+
+    private static final class GenTask implements Runnable, Comparable<GenTask>
+    {
+        private final GenKey key;
+        private final int x;
+        private final int z;
+        private final int priority;
+        private final boolean unloadWhenDone;
+        private final long sequence = SEQUENCE.incrementAndGet();
+        private final CopyOnWriteArrayList<Runnable> callbacks = new CopyOnWriteArrayList<Runnable>();
+        private volatile Chunk chunk;
+        private volatile Throwable error;
+        private volatile boolean done;
+        private volatile boolean cancelled;
+        private boolean inline;
+
+        private GenTask(GenKey key, int x, int z, int priority, boolean unloadWhenDone)
+        {
+            this.key = key;
+            this.x = x;
+            this.z = z;
+            this.priority = priority;
+            this.unloadWhenDone = unloadWhenDone;
+        }
+
+        @Override
+        public void run()
+        {
+            if (!this.inline)
+            {
+                // Give the server thread a chance to grab the lock between two chunks.
+                try
+                {
+                    Thread.sleep(1L);
+                }
+                catch (InterruptedException interrupted)
+                {
+                    Thread.currentThread().interrupt();
+                }
+            }
+
+            try
+            {
+                if (!this.cancelled)
+                {
+                    WORLDGEN.lock();
+                    try
+                    {
+                        if (!this.cancelled)
+                        {
+                            this.chunk = this.key.provider.chunkGenerator.generateChunk(this.x, this.z);
+                        }
+                    }
+                    finally
+                    {
+                        WORLDGEN.unlock();
+                    }
+                }
+            }
+            catch (Throwable throwable)
+            {
+                this.error = throwable;
+            }
+            finally
+            {
+                this.done = true;
+                synchronized (this)
+                {
+                    this.notifyAll();
+                }
+            }
+        }
+
+        private void runInline()
+        {
+            this.inline = true;
+            this.run();
+        }
+
+        private void runCallbacks()
+        {
+            for (Runnable callback : this.callbacks)
+            {
+                try
+                {
+                    callback.run();
+                }
+                catch (Throwable throwable)
+                {
+                    LOGGER.error("[chunkgen] callback failed", throwable);
+                }
+            }
+            this.callbacks.clear();
+        }
+
+        @Override
+        public int compareTo(GenTask other)
+        {
+            int byPriority = Integer.compare(this.priority, other.priority);
+            return byPriority != 0 ? byPriority : Long.compare(this.sequence, other.sequence);
+        }
+    }
+
+    private static final class PostTask
+    {
+        private final ChunkProviderServer provider;
+        private final Chunk chunk;
+        private final boolean recreateStructures;
+        private final Runnable after;
+
+        private PostTask(ChunkProviderServer provider, Chunk chunk, boolean recreateStructures, Runnable after)
+        {
+            this.provider = provider;
+            this.chunk = chunk;
+            this.recreateStructures = recreateStructures;
+            this.after = after;
+        }
+    }
+}
