     public BufferBuilder getWorldRendererByLayerId(int id)
     {
-        return this.worldRenderers[id];
+        BufferBuilder buffer = this.worldRenderers[id];
+
+        if (buffer == null)
+        {
+            int initial = CUTOUT_INITIAL_INTS;
+
+            if (id == BlockRenderLayer.SOLID.ordinal())
+            {
+                initial = SOLID_INITIAL_INTS;
+            }
+            else if (id == BlockRenderLayer.TRANSLUCENT.ordinal())
+            {
+                initial = TRANSLUCENT_INITIAL_INTS;
+            }
+
+            buffer = new BufferBuilder(initial);
+            this.worldRenderers[id] = buffer;
+        }
+
+        return buffer;
     }
