+import java.util.jar.Manifest;
+import java.util.stream.Stream;
+import java.util.zip.ZipEntry;
+import net.minecraft.launchwrapper.Launch;
+import net.minecraft.launchwrapper.LaunchClassLoader;
+import net.minecraftforge.common.ForgeVersion;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+/**
+ * Persistent class-byte cache.
+ *
+ * LaunchClassLoader already keeps raw class bytes in a ConcurrentHashMap named resourceCache. We pre-populate that
+ * map from a disk file before mod discovery/init, so classloading during preInit/init does not have to open and
+ * decompress every mod jar again. The map is populated by reflection and remains a normal ConcurrentHashMap, so
+ * LaunchClassLoader's own getClassBytes path stays intact.
+ *
+ * The cache file is keyed by mods + the Forge jar metadata + Forge/MC/cache version. Only .class byte arrays are
+ * stored; nothing is executed while building the cache.
+ *
+ * -Dforge.threading.classCache=false disables it.
+ */
+public final class ClassCache
+{
+    private static final Logger LOGGER = LogManager.getLogger("ForgeThreading");
+    // Measured on the 38-mod test pack: building/loading class bytes did not beat the normal
+    // LaunchClassLoader path and added ~165 MB. Keep it as an explicit opt-in experiment only.
+    private static final boolean ENABLED = Boolean.parseBoolean(System.getProperty("forge.threading.classCache", "false"));
+    private static final int MAGIC = 0x434C4331;
+    private static final int VERSION = 2;
+    private static final int MAX_CACHE_FILES = 3;
+    private static final long MAX_CACHE_BYTES = 256L * 1024L * 1024L;
+    private static volatile boolean installed;
+    private static volatile boolean building;
+    private static volatile String cachedKey;
+
+    private ClassCache()
+    {
+    }
+
+    public static void install(LaunchClassLoader loader)
+    {
+        if (!ENABLED || installed || loader == null)
+        {
+            return;
+        }
+        synchronized (ClassCache.class)
+        {
+            if (installed)
+            {
+                return;
+            }
+            installed = true;
+        }
+
+        try
+        {
+            File gameDir = Launch.minecraftHome != null ? Launch.minecraftHome : new File(System.getProperty("user.dir"));
+            Map<String, byte[]> cache = resourceCache(loader);
+            if (cache == null)
+            {
+                return;
+            }
+
+            File file = cacheFile(gameDir);
+            if (file != null && file.isFile() && file.length() <= MAX_CACHE_BYTES)
+            {
+                load(cache, file);
+            }
+            else
+            {
+                buildAsync(gameDir, loader, cache, file);
+            }
+        }
+        catch (Throwable throwable)
+        {
+            LOGGER.warn("[class-cache] install failed; using normal classloading", throwable);
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    private static Map<String, byte[]> resourceCache(LaunchClassLoader loader) throws Exception
+    {
+        Field field = LaunchClassLoader.class.getDeclaredField("resourceCache");
+        field.setAccessible(true);
+        Object value = field.get(loader);
+        return value instanceof Map ? (Map<String, byte[]>)value : null;
+    }
+
+    private static void load(Map<String, byte[]> cache, File file)
+    {
+        long start = System.nanoTime();
+        int loaded = 0;
+        try (DataInputStream in = new DataInputStream(new BufferedInputStream(new FileInputStream(file))))
+        {
+            if (in.readInt() != MAGIC || in.readInt() != VERSION)
+            {
+                LOGGER.warn("[class-cache] incompatible cache {}", file.getName());
+                return;
+            }
+            String key = in.readUTF();
+            if (!key.equals(key(file.getParentFile().getParentFile())))
+            {
+                LOGGER.info("[class-cache] key changed, ignoring {}", file.getName());
+                return;
+            }
+            int count = in.readInt();
+            for (int index = 0; index < count; index++)
+            {
+                String className = in.readUTF();
+                int length = in.readInt();
+                byte[] data = new byte[length];
+                in.readFully(data);
+                if (cache.putIfAbsent(className, data) == null)
+                {
+                    loaded++;
+                }
+            }
+        }
+        catch (Throwable throwable)
+        {
+            LOGGER.warn("[class-cache] load failed", throwable);
+            return;
+        }
+
+        double ms = (System.nanoTime() - start) / 1.0E6D;
+        LOGGER.info("[class-cache] loaded {} class byte arrays in {} ms from {}", Integer.valueOf(loaded),
+                String.format("%.1f", Double.valueOf(ms)), file.getName());
+    }
+
+    private static void buildAsync(File gameDir, LaunchClassLoader loader, Map<String, byte[]> cache, File target)
+    {
+        if (building || target == null)
+        {
+            return;
+        }
+        synchronized (ClassCache.class)
+        {
+            if (building)
+            {
+                return;
+            }
+            building = true;
+        }
+
+        Thread thread = new Thread(() -> build(gameDir, loader, cache, target), "ForgeClassCache-Build");
+        thread.setDaemon(true);
+        thread.setPriority(Thread.MIN_PRIORITY);
+        thread.start();
+        LOGGER.info("[class-cache] building cache in background");
+    }
+
+    private static void build(File gameDir, LaunchClassLoader loader, Map<String, byte[]> cache, File target)
+    {
+        File tmp = new File(target.getParentFile(), target.getName() + ".tmp");
+        long start = System.nanoTime();
+        int written = 0;
+
+        try
+        {
+            if (!target.getParentFile().isDirectory() && !target.getParentFile().mkdirs())
+            {
+                return;
+            }
+
+            Set<File> jars = jars(gameDir, loader);
+            Set<String> seen = new HashSet<String>();
+
+            try (RandomAccessFile out = new RandomAccessFile(tmp, "rw"))
+            {
+                out.writeInt(MAGIC);
+                out.writeInt(VERSION);
+                out.writeUTF(key(gameDir));
+                long countPosition = out.getFilePointer();
+                out.writeInt(0);
+
+                for (File jar : jars)
+                {
+                    try (JarFile zip = new JarFile(jar))
+                    {
+                        if (isSignedOrSealed(zip))
+                        {
+                            continue;
+                        }
+
+                        Enumeration<? extends ZipEntry> entries = zip.entries();
+                        while (entries.hasMoreElements())
+                        {
+                            ZipEntry entry = entries.nextElement();
+                            String name = entry.getName();
+                            if (entry.isDirectory() || !name.endsWith(".class"))
+                            {
+                                continue;
+                            }
+                            String className = name.substring(0, name.length() - 6).replace('/', '.');
+                            if (!seen.add(className))
+                            {
+                                continue;
+                            }
+
+                            byte[] data;
+                            try (InputStream in = zip.getInputStream(entry))
+                            {
+                                data = readAll(in, entry.getSize());
+                            }
+                            cache.putIfAbsent(className, data);
+                            out.writeUTF(className);
+                            out.writeInt(data.length);
+                            out.write(data);
+                            written++;
+                        }
+                    }
+                    catch (Throwable throwable)
+                    {
+                        // A malformed/nested jar must not break startup or the cache.
+                    }
+                }
+
+                out.seek(countPosition);
+                out.writeInt(written);
+            }
+
+            Files.move(tmp.toPath(), target.toPath(), StandardCopyOption.REPLACE_EXISTING);
+            double ms = (System.nanoTime() - start) / 1.0E6D;
+            LOGGER.info("[class-cache] built {} class byte arrays in {} ms to {}", Integer.valueOf(written),
+                    String.format("%.1f", Double.valueOf(ms)), target.getName());
+            cleanup(target.getParentFile());
+        }
+        catch (Throwable throwable)
+        {
+            LOGGER.warn("[class-cache] build failed", throwable);
+            if (tmp.isFile())
+            {
+                tmp.delete();
+            }
+        }
+    }
+
+    private static boolean isSignedOrSealed(JarFile jar)
+    {
+        try
+        {
+            Manifest manifest = jar.getManifest();
+            if (manifest != null && "true".equalsIgnoreCase(manifest.getMainAttributes().getValue("Sealed")))
+            {
+                return true;
+            }
+        }
+        catch (Throwable ignored)
+        {
+        }
+
+        Enumeration<? extends ZipEntry> entries = jar.entries();
+        while (entries.hasMoreElements())
+        {
+            String name = entries.nextElement().getName().toUpperCase(Locale.ROOT);
+            if (name.startsWith("META-INF/")
+                    && (name.endsWith(".SF") || name.endsWith(".RSA") || name.endsWith(".DSA") || name.endsWith(".EC")))
+            {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static Set<File> jars(File gameDir, LaunchClassLoader loader)
+    {
+        Set<File> jars = new HashSet<File>();
+        try
+        {
+            for (URL url : loader.getSources())
+            {
+                if ("file".equalsIgnoreCase(url.getProtocol()))
+                {
+                    URI uri = url.toURI();
+                    File file = new File(uri);
+                    if (file.isFile() && (file.getName().endsWith(".jar") || file.getName().endsWith(".zip")))
+                    {
+                        jars.add(file);
+                    }
+                }
+            }
+        }
+        catch (Throwable ignored)
+        {
+        }
+
+        File mods = new File(gameDir, "mods");
+        if (mods.isDirectory())
+        {
+            try (Stream<Path> stream = Files.walk(mods.toPath()))
+            {
+                stream.filter(Files::isRegularFile)
+                        .map(Path::toFile)
+                        .filter(file -> file.getName().endsWith(".jar") || file.getName().endsWith(".zip"))
+                        .forEach(jars::add);
+            }
+            catch (Throwable ignored)
+            {
+            }
+        }
+
+        try
+        {
+            URL location = ClassCache.class.getProtectionDomain().getCodeSource().getLocation();
+            if (location != null && "file".equalsIgnoreCase(location.getProtocol()))
+            {
+                File file = new File(location.toURI());
+                if (file.isFile())
+                {
+                    jars.add(file);
+                }
+            }
+        }
+        catch (Throwable ignored)
+        {
+        }
+        return jars;
+    }
+
+    private static byte[] readAll(InputStream in, long size) throws IOException
+    {
+        if (size > 0L && size <= Integer.MAX_VALUE)
+        {
+            byte[] data = new byte[(int)size];
+            int offset = 0;
+            while (offset < data.length)
+            {
+                int read = in.read(data, offset, data.length - offset);
+                if (read < 0)
+                {
+                    break;
+                }
+                offset += read;
+            }
+            if (offset == data.length)
+            {
+                return data;
+            }
+        }
+
+        java.io.ByteArrayOutputStream bytes = new java.io.ByteArrayOutputStream(8192);
+        byte[] buffer = new byte[8192];
+        int read;
+        while ((read = in.read(buffer)) >= 0)
+        {
+            bytes.write(buffer, 0, read);
+        }
+        return bytes.toByteArray();
+    }
+
+    private static File cacheFile(File gameDir) throws Exception
+    {
+        File dir = new File(gameDir, "forge-class-cache");
+        return new File(dir, "classcache-" + key(gameDir) + ".bin");
+    }
+
+    private static String key(File gameDir)
+    {
+        String key = cachedKey;
+        if (key != null)
+        {
+            return key;
+        }
+        synchronized (ClassCache.class)
+        {
+            if (cachedKey != null)
+            {
+                return cachedKey;
+            }
+            try
+            {
+                MessageDigest digest = MessageDigest.getInstance("SHA-256");
+                update(digest, "class-cache=" + VERSION);
+                update(digest, "mc=" + ForgeVersion.mcVersion);
+                update(digest, "forge=" + ForgeVersion.majorVersion + "." + ForgeVersion.minorVersion + "."
+                        + ForgeVersion.revisionVersion + "." + ForgeVersion.buildVersion);
+                hashDir(digest, new File(gameDir, "mods"));
+                try
+                {
+                    URL location = ClassCache.class.getProtectionDomain().getCodeSource().getLocation();
+                    if (location != null && "file".equalsIgnoreCase(location.getProtocol()))
+                    {
+                        File file = new File(location.toURI());
+                        update(digest, file.getAbsolutePath() + "|" + file.length() + "|" + file.lastModified());
+                    }
+                }
+                catch (Throwable ignored)
+                {
+                }
+                byte[] hash = digest.digest();
+                StringBuilder builder = new StringBuilder(hash.length * 2);
+                for (byte value : hash)
+                {
+                    builder.append(String.format("%02x", Integer.valueOf(value & 255)));
+                }
+                cachedKey = builder.toString();
+                return cachedKey;
+            }
+            catch (Throwable throwable)
+            {
+                cachedKey = "nocache";
+                return cachedKey;
+            }
+        }
+    }
+
+    private static void hashDir(MessageDigest digest, File dir)
+    {
+        if (dir == null || !dir.isDirectory())
+        {
+            return;
+        }
+        Path root = dir.toPath();
+        try (Stream<Path> stream = Files.walk(root))
+        {
+            stream.filter(Files::isRegularFile)
+                    .sorted(Comparator.comparing(path -> root.relativize(path).toString()))
+                    .forEach(path ->
+                    {
+                        try
+                        {
+                            String relative = root.relativize(path).toString().replace('\\', '/');
+                            update(digest, relative + "|" + Files.size(path) + "|" + Files.getLastModifiedTime(path).toMillis());
+                        }
+                        catch (Throwable ignored)
+                        {
+                        }
+                    });
+        }
+        catch (Throwable ignored)
+        {
+        }
+    }
+
+    private static void update(MessageDigest digest, String value)
+    {
+        digest.update(value.getBytes(StandardCharsets.UTF_8));
+        digest.update((byte)0);
+    }
+
+    private static void cleanup(File dir)
+    {
+        File[] files = dir.listFiles((directory, name) -> name.startsWith("classcache-") && name.endsWith(".bin"));
+        if (files == null || files.length <= MAX_CACHE_FILES)
+        {
+            return;
+        }
+        List<File> list = new ArrayList<File>();
+        for (File file : files)
+        {
+            list.add(file);
+        }
+        list.sort(Comparator.comparingLong(File::lastModified).reversed());
+        for (int index = MAX_CACHE_FILES; index < list.size(); index++)
+        {
+            list.get(index).delete();
+        }
+    }
+}
diff --git a/net/minecraftforge/common/threading/ClientRenderGovernor.java b/net/minecraftforge/common/threading/ClientRenderGovernor.java
new file mode 100644
index 0000000..40e2272
--- /dev/null
+++ b/net/minecraftforge/common/threading/ClientRenderGovernor.java
@@ -0,0 +1,218 @@
+/*
+ * Minecraft Forge
+ * Copyright (c) 2016-2020.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation version 2.1
+ * of the License.
+ */
+
+package net.minecraftforge.common.threading;
+
+import java.util.concurrent.TimeUnit;
+import net.minecraft.client.Minecraft;
+import net.minecraftforge.fml.relauncher.Side;
+import net.minecraftforge.fml.relauncher.SideOnly;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+/**
+ * Adaptive client render distance.
+ *
+ * <p>RD32 on integrated graphics is fill-rate/geometry bound: the far ring costs far more than the frame budget, and
+ * neither per-section nor merged far-ring LOD produced an acceptable picture on the reference Intel client. This
+ * governor instead treats render distance as a dynamic quality setting, the same way console games scale resolution:
+ *
+ * <ul>
+ *   <li>it measures the real client frame time (after the FPS limiter);</li>
+ *   <li>when the rolling average is over budget it jumps directly to a distance that should hold the target (one
+ *       renderer reload instead of a staircase of reloads);</li>
+ *   <li>after a drop it refuses to grow for a minute, so looking at the sky for half a second cannot undo the drop
+ *       and start an oscillation;</li>
+ *   <li>it grows one chunk at a time only after a long uninterrupted good window.</li>
+ * </ul>
+ *
+ * <p>The integrated server already mirrors {@code gameSettings.renderDistanceChunks} into the player-list view
+ * distance every tick, so both the client renderer and the server chunk view shrink/grow together. The far ring
+ * fades into normal fog instead of coarse LOD geometry.
+ *
+ * <p>Disable with {@code -Dforge.threading.clientRenderGovernor=false}. Tunables:
+ * {@code clientRenderGovernorMinRd=6}, {@code ...LowMs=8}, {@code ...RecoverMs=5},
+ * {@code ...LowSeconds=0.75}, {@code ...RecoverSeconds=15}, {@code ...PenaltySeconds=30}.
+ */
+@SideOnly(Side.CLIENT)
+public final class ClientRenderGovernor
+{
+    private static final Logger LOGGER = LogManager.getLogger("ForgeThreading");
+    private static final boolean ENABLED = Boolean.parseBoolean(
+            System.getProperty("forge.threading.clientRenderGovernor", "true"));
+    private static final int MIN_RD = Math.max(2, Integer.getInteger(
+            "forge.threading.clientRenderGovernorMinRd", 6).intValue());
+    private static final double LOW_MS = Double.parseDouble(
+            System.getProperty("forge.threading.clientRenderGovernorLowMs", "8"));
+    private static final double RECOVER_MS = Double.parseDouble(
+            System.getProperty("forge.threading.clientRenderGovernorRecoverMs", "5"));
+    private static final long LOW_NANOS = TimeUnit.MILLISECONDS.toNanos(Math.max(100L,
+            (long)(Double.parseDouble(System.getProperty("forge.threading.clientRenderGovernorLowSeconds", "0.75"))
+                    * 1000.0D)));
+    private static final long RECOVER_NANOS = TimeUnit.SECONDS.toNanos(Math.max(1L,
+            Long.getLong("forge.threading.clientRenderGovernorRecoverSeconds", 15L).longValue()));
+    private static final long PENALTY_NANOS = TimeUnit.SECONDS.toNanos(Math.max(0L,
+            Long.getLong("forge.threading.clientRenderGovernorPenaltySeconds", 30L).longValue()));
+    private static final long COOLDOWN_NANOS = TimeUnit.MILLISECONDS.toNanos(1500L);
+
+    private static double averageMs = 16.0D;
+    private static int baseRd = -1;
+    private static int currentRd = -1;
+    private static long lowNanos;
+    private static long recoverNanos;
+    private static long cooldownUntil;
+    private static long penaltyUntil;
+
+    private ClientRenderGovernor()
+    {
+    }
+
+    public static void onClientFrame(long nanos)
+    {
+        if (!ENABLED)
+        {
+            return;
+        }
+
+        Minecraft mc = Minecraft.getMinecraft();
+
+        if (mc == null || mc.gameSettings == null || mc.world == null || mc.currentScreen != null
+                || !mc.inGameHasFocus)
+        {
+            return;
+        }
+
+        double frameMs = (double)nanos / 1000000.0D;
+
+        if (baseRd <= 0)
+        {
+            baseRd = mc.gameSettings.renderDistanceChunks;
+            currentRd = baseRd;
+            averageMs = frameMs;
+            return;
+        }
+
+        // The user changed the setting manually (or another mod did): accept it as the new ceiling and forget the
+        // previous penalty.
+        if (mc.gameSettings.renderDistanceChunks != currentRd)
+        {
+            baseRd = mc.gameSettings.renderDistanceChunks;
+            currentRd = baseRd;
+            lowNanos = 0L;
+            recoverNanos = 0L;
+            penaltyUntil = 0L;
+            cooldownUntil = System.nanoTime() + COOLDOWN_NANOS;
+            averageMs = frameMs;
+            return;
+        }
+
+        averageMs = averageMs * 0.85D + frameMs * 0.15D;
+
+        long now = System.nanoTime();
+
+        if (now < cooldownUntil)
+        {
+            return;
+        }
+
+        if (averageMs > LOW_MS)
+        {
+            lowNanos += Math.max(0L, nanos);
+            recoverNanos = 0L;
+        }
+        else if (averageMs < RECOVER_MS)
+        {
+            recoverNanos += Math.max(0L, nanos);
+            lowNanos = 0L;
+        }
+        else
+        {
+            lowNanos = 0L;
+            recoverNanos = 0L;
+        }
+
+        if (lowNanos >= LOW_NANOS)
+        {
+            int target = targetFor(averageMs);
+
+            if (target < currentRd)
+            {
+                apply(mc, target);
+                penaltyUntil = now + PENALTY_NANOS;
+            }
+
+            lowNanos = 0L;
+            return;
+        }
+
+        if (recoverNanos >= RECOVER_NANOS && now >= penaltyUntil && currentRd < baseRd)
+        {
+            apply(mc, Math.min(baseRd, currentRd + 1));
+            recoverNanos = 0L;
+        }
+    }
+
+    /**
+     * The server must keep sending chunks up to the user's configured distance even while the client renders a
+     * smaller adaptive distance. Otherwise the server unloads the far chunks, the client raises its render distance
+     * again (e.g. while looking at the sky) and the far ring renders as empty holes until it reloads. Keeping the
+     * server view at the ceiling pre-fills the client chunk cache, so a later render-distance increase is hole-free.
+     */
+    public static int getServerViewDistance(int clientRenderDistance)
+    {
+        int base = baseRd;
+        return base > 0 ? Math.max(base, clientRenderDistance) : clientRenderDistance;
+    }
+
+    /** Maps a too-high frame time directly to a distance that should fit the budget. */
+    private static int targetFor(double frameMs)
+    {
+        if (frameMs > 14.0D)
+        {
+            return Math.max(MIN_RD, 8);
+        }
+        if (frameMs > 11.0D)
+        {
+            return Math.max(MIN_RD, 10);
+        }
+        if (frameMs > 8.0D)
+        {
+            return Math.max(MIN_RD, 12);
+        }
+        if (frameMs > 6.0D)
+        {
+            return Math.max(MIN_RD, 14);
+        }
+        if (frameMs > 5.0D)
+        {
+            return Math.max(MIN_RD, 16);
+        }
+        return Math.max(MIN_RD, 20);
+    }
+
+    private static void apply(Minecraft mc, int target)
+    {
+        int clamped = Math.max(MIN_RD, Math.min(baseRd, target));
+
+        if (clamped == currentRd)
+        {
+            cooldownUntil = System.nanoTime() + COOLDOWN_NANOS;
+            return;
+        }
+
+        int previous = currentRd;
+        currentRd = clamped;
+        mc.gameSettings.renderDistanceChunks = clamped;
+        cooldownUntil = System.nanoTime() + COOLDOWN_NANOS;
+        LOGGER.info("[render-governor] renderDistance {} -> {} (avg {} ms)", Integer.valueOf(previous),
+                Integer.valueOf(clamped), String.format(java.util.Locale.ROOT, "%.1f", Double.valueOf(averageMs)));
+    }
+}
+
diff --git a/net/minecraftforge/common/threading/ClientRenderSnapshot.java b/net/minecraftforge/common/threading/ClientRenderSnapshot.java
new file mode 100644
index 0000000..a409ecd
