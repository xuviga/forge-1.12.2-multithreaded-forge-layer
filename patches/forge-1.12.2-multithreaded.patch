+/*
+ * Minecraft Forge
+ * Copyright (c) 2016-2020.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation version 2.1
+ * of the License.
+ */
+
+package net.minecraftforge.common.threading;
+
+import net.minecraft.util.IThreadListener;
+import net.minecraft.world.World;
+
+/**
+ * A thread that owns (part of) a world for the duration of a tick.
+ *
+ * Whole-dimension ticking uses a null region and the whole WorldServer; regionized ticking (Phase 3) uses a
+ * non-null region. Code that mutates world state must run on the returned owner.
+ */
+public interface ITickThread extends IThreadListener
+{
+    World getWorld();
+
+    Region getRegion();
+
+    TickPhase getPhase();
+
+    long getTickId();
+
+    /**
+     * @return true if this thread is allowed to mutate the given object (entity, tile entity, chunk, ...).
+     *         The default implementation only checks the world and, when present, the region.
+     */
+    default boolean owns(Object target)
+    {
+        return true;
+    }
+
+    default boolean ownsChunk(int chunkX, int chunkZ)
+    {
+        Region region = getRegion();
+        return region == null || region.containsChunk(chunkX, chunkZ);
+    }
+
+    default boolean isRegionThread()
+    {
+        return getRegion() != null;
+    }
+
+    default TickContext newContext()
+    {
+        TickContext context = new TickContext(Thread.currentThread());
+        context.setWorld(getWorld());
+        context.setRegion(getRegion());
+        context.setPhase(getPhase());
+        context.setTickId(getTickId());
+        return context;
+    }
+}
diff --git a/net/minecraftforge/common/threading/InboundPacketPipeline.java b/net/minecraftforge/common/threading/InboundPacketPipeline.java
new file mode 100644
index 0000000..b29846d
--- /dev/null
+++ b/net/minecraftforge/common/threading/InboundPacketPipeline.java
@@ -0,0 +1,142 @@
+/*
+ * Minecraft Forge
+ * Copyright (c) 2016-2020.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation version 2.1
+ * of the License.
+ */
+
+package net.minecraftforge.common.threading;
+
+import java.util.Queue;
+import java.util.concurrent.ConcurrentLinkedQueue;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ThreadFactory;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicLong;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+/**
+ * Inbound packet processing pipeline.
+ *
+ * Netty decodes packets on its IO event loops, but a slow packet handler on one channel can stall every other channel
+ * assigned to that loop. This pipeline moves packet-handler execution to a per-connection ordered queue on a shared
+ * worker pool. Per-connection order is preserved; cross-connection handlers run in parallel.
+ *
+ * Handlers that need the game thread call PacketThreadUtil.checkThreadAndEnqueue as usual, so world/player work is
+ * still re-submitted to the owning server/client thread. Handlers that are thread-safe run directly on the inbound
+ * worker. Local (single-player) channels keep the vanilla path.
+ *
+ * -Dforge.threading.inboundPipeline=false disables it; singleThreaded also disables it.
+ */
+public final class InboundPacketPipeline
+{
+    private static final Logger LOGGER = LogManager.getLogger("ForgeThreading");
+    private static final boolean ENABLED = !Threading.isSingleThreaded() &&
+            Boolean.parseBoolean(System.getProperty("forge.threading.inboundPipeline", "true"));
+    private static final int THREADS = Math.max(1, Math.min(8, Integer.getInteger(
+            "forge.threading.inboundPipelineThreads",
+            Math.max(1, Runtime.getRuntime().availableProcessors() / 2)).intValue()));
+    private static final AtomicInteger IDS = new AtomicInteger();
+    private static final AtomicLong PROCESSED = new AtomicLong();
+    private static final ExecutorService POOL = Executors.newFixedThreadPool(THREADS, new ThreadFactory()
+    {
+        @Override
+        public Thread newThread(Runnable runnable)
+        {
+            Thread thread = new Thread(net.minecraftforge.fml.common.thread.SidedThreadGroups.SERVER,
+                    runnable, "Inbound Packet #" + IDS.incrementAndGet());
+            thread.setDaemon(true);
+            return thread;
+        }
+    });
+
+    static
+    {
+        ThreadingTelemetry.registerPool("packetIn", POOL);
+    }
+
+    private InboundPacketPipeline()
+    {
+    }
+
+    public static boolean isEnabled()
+    {
+        return ENABLED;
+    }
+
+    public static Serial newSerial()
+    {
+        return new Serial();
+    }
+
+    public static void recordProcessed()
+    {
+        ThreadingTelemetry.increment("net.in");
+        long count = PROCESSED.incrementAndGet();
+        if (count == 1L || count % 5000L == 0L)
+        {
+            LOGGER.info("[inbound-pipeline] processed {} packets on {} threads", Long.valueOf(count),
+                    Integer.valueOf(THREADS));
+        }
+    }
+
+    /**
+     * Per-connection serial executor. Tasks for one channel run in arrival order on the shared pool.
+     */
+    public static final class Serial
+    {
+        private final Queue<Runnable> tasks = new ConcurrentLinkedQueue<Runnable>();
+        private final AtomicBoolean draining = new AtomicBoolean();
+
+        private Serial()
+        {
+        }
+
+        public void execute(Runnable task)
+        {
+            this.tasks.add(task);
+            if (this.draining.compareAndSet(false, true))
+            {
+                POOL.execute(this::drain);
+            }
+        }
+
+        public int pending()
+        {
+            return this.tasks.size();
+        }
+
+        private void drain()
+        {
+            try
+            {
+                Runnable task;
+                while ((task = this.tasks.poll()) != null)
+                {
+                    try
+                    {
+                        task.run();
+                    }
+                    catch (Throwable throwable)
+                    {
+                        LOGGER.error("[inbound-pipeline] task failed", throwable);
+                    }
+                }
+            }
+            finally
+            {
+                this.draining.set(false);
+                if (!this.tasks.isEmpty() && this.draining.compareAndSet(false, true))
+                {
+                    POOL.execute(this::drain);
+                }
+            }
+        }
+    }
+}
diff --git a/net/minecraftforge/common/threading/LightingExecutor.java b/net/minecraftforge/common/threading/LightingExecutor.java
new file mode 100644
index 0000000..32c03c9
--- /dev/null
+++ b/net/minecraftforge/common/threading/LightingExecutor.java
@@ -0,0 +1,122 @@
+/*
+ * Minecraft Forge
+ * Copyright (c) 2016-2020.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation version 2.1
+ * of the License.
+ */
+
+package net.minecraftforge.common.threading;
+
+import java.util.concurrent.locks.ReentrantLock;
+import java.util.concurrent.locks.ReentrantReadWriteLock;
+import net.minecraft.util.math.BlockPos;
+import net.minecraft.world.World;
+
+/**
+ * Sharded light-propagation locks.
+ *
+ * Vanilla's light engine uses a single 32768-entry scratch buffer and a global BFS. The buffer is now thread-local
+ * (World#lightBufferLocal) and the light arrays are guarded by:
+ *
+ *   - 16 shard locks for interior updates (a 256-block region, at least 36 blocks from an edge),
+ *   - a global read lock shared by all interior updates,
+ *   - a global write lock for boundary updates and for non-finite safety.
+ *
+ * Interior updates in different shards touch disjoint light arrays (BFS radius is 17; margin is 36), so they run in
+ * parallel. Any update that can reach a shard edge takes the write lock, which excludes every interior update. That
+ * makes the sharding conservative but correct.
+ *
+ * -Dforge.threading.parallelLighting=false disables sharding (global write lock). singleThreaded forces it off.
+ */
+public final class LightingExecutor
+{
+    private static final int SHARD_BLOCKS = 256;
+    private static final int SHARD_MARGIN = 36;
+    private static final int SHARD_MASK = 3;
+    private static final ReentrantLock[] SHARDS = new ReentrantLock[16];
+    private static final ReentrantReadWriteLock GLOBAL = new ReentrantReadWriteLock();
+    private static final boolean ENABLED = !Threading.isSingleThreaded() &&
+            Boolean.parseBoolean(System.getProperty("forge.threading.parallelLighting", "true"));
+
+    static
+    {
+        for (int index = 0; index < SHARDS.length; index++)
+        {
+            SHARDS[index] = new ReentrantLock();
+        }
+    }
+
+    private LightingExecutor()
+    {
+    }
+
+    public static boolean isEnabled()
+    {
+        return ENABLED && !Threading.isLowMemory();
+    }
+
+    /**
+     * Acquires a light-update lock. The caller must call {@link LightLock#release()} in a finally block.
+     */
+    public static LightLock acquire(World world, BlockPos pos)
+    {
+        if (!ENABLED)
+        {
+            ThreadingTelemetry.increment("light.global");
+            GLOBAL.writeLock().lock();
+            return new LightLock(null, true);
+        }
+
+        int x = pos.getX();
+        int z = pos.getZ();
+        int localX = Math.floorMod(x, SHARD_BLOCKS);
+        int localZ = Math.floorMod(z, SHARD_BLOCKS);
+        if (localX < SHARD_MARGIN || localX > SHARD_BLOCKS - SHARD_MARGIN ||
+                localZ < SHARD_MARGIN || localZ > SHARD_BLOCKS - SHARD_MARGIN)
+        {
+            ThreadingTelemetry.increment("light.global");
+            GLOBAL.writeLock().lock();
+            return new LightLock(null, true);
+        }
+
+        ThreadingTelemetry.increment("light.shard");
+        GLOBAL.readLock().lock();
+        int shardX = Math.floorDiv(x, SHARD_BLOCKS) & SHARD_MASK;
+        int shardZ = Math.floorDiv(z, SHARD_BLOCKS) & SHARD_MASK;
+        ReentrantLock shard = SHARDS[(shardX << 2) | shardZ];
+        shard.lock();
+        return new LightLock(shard, false);
+    }
+
+    /**
+     * Release token. Interior updates hold the global read lock plus one shard lock; boundary updates hold only the
+     * global write lock.
+     */
+    public static final class LightLock
+    {
+        private final ReentrantLock shard;
+        private final boolean writer;
+
+        private LightLock(ReentrantLock shard, boolean writer)
+        {
+            this.shard = shard;
+            this.writer = writer;
+        }
+
+        public void release()
+        {
+            if (this.writer)
+            {
+                GLOBAL.writeLock().unlock();
+            }
+            else
+            {
+                this.shard.unlock();
+                GLOBAL.readLock().unlock();
+            }
+        }
+    }
+}
diff --git a/net/minecraftforge/common/threading/LoadingExecutor.java b/net/minecraftforge/common/threading/LoadingExecutor.java
new file mode 100644
index 0000000..bd72f1f
--- /dev/null
+++ b/net/minecraftforge/common/threading/LoadingExecutor.java
@@ -0,0 +1,105 @@
+/*
+ * Minecraft Forge
+ * Copyright (c) 2016-2020.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation version 2.1
+ * of the License.
+ */
+
+package net.minecraftforge.common.threading;
+
+import java.util.concurrent.ForkJoinPool;
+import java.util.stream.IntStream;
+
+/**
+ * Ordered fan-out/fan-in helper for the FML loading pipeline.
+ *
+ * Mod jars/directories and recipe JSON files are independent work items, but the game insists on deterministic
+ * results: candidate scan order drives duplicate detection, and recipe registration order must match the on-disk
+ * order. This helper therefore never lets workers append into shared output structures. Each index owns its slot in
+ * a pre-sized array, the pool is joined before the caller reads the array, and the caller merges in index order.
+ *
+ * A dedicated short-lived {@link ForkJoinPool} is used instead of the common pool so loading cannot be starved by
+ * (or starve) unrelated work, and so the pool is gone once the phase is over. The pool is not registered with
+ * {@link ThreadingTelemetry} because it does not outlive the phase; the phase duration is recorded instead.
+ */
+public final class LoadingExecutor
+{
+    private static final org.apache.logging.log4j.Logger LOGGER = org.apache.logging.log4j.LogManager.getLogger("ForgeThreading");
+
+    private LoadingExecutor()
+    {
+    }
+
+    /**
+     * Runs {@code task} for every index in {@code [0, count)} and returns only after all of them have completed.
+     * Results are stored by the task itself, so ordering is whatever the caller's array defines.
+     *
+     * @param count number of independent work items
+     * @param phase telemetry key, e.g. {@code load.discovery}
+     * @param task  per-index work item; must not throw for recoverable failures
+     * @return true when the work actually ran on more than one thread
+     */
+    public static boolean runIndexed(int count, String phase, IndexedTask task)
+    {
+        return runIndexed(count, phase, task, Threading.isParallelLoadingEnabled());
+    }
+
+    /**
+     * Same as {@link #runIndexed(int, String, IndexedTask)} but lets the caller choose the phase-specific gate
+     * (discovery vs recipes) without duplicating the sequential fallback.
+     */
+    public static boolean runIndexed(int count, String phase, IndexedTask task, boolean allowParallel)
+    {
+        long start = System.nanoTime();
+        try
+        {
+            if (count <= 1 || !allowParallel || !Threading.isParallelLoadingEnabled())
+            {
+                for (int index = 0; index < count; index++)
+                {
+                    task.run(index);
+                }
+                return false;
+            }
+
+            final int threads = Math.min(Threading.getLoadThreads(), count);
+            if (threads <= 1)
+            {
+                for (int index = 0; index < count; index++)
+                {
+                    task.run(index);
+                }
+                return false;
+            }
+
+            if (LOGGER.isDebugEnabled())
+            {
+                LOGGER.debug("[load] {}: {} items on {} threads", phase, Integer.valueOf(count), Integer.valueOf(threads));
+            }
+
+            ForkJoinPool pool = new ForkJoinPool(threads);
+            try
+            {
+                pool.submit(() -> IntStream.range(0, count).parallel().forEach(task::run)).join();
+            }
+            finally
+            {
+                pool.shutdown();
+            }
+            return true;
+        }
+        finally
+        {
+            ThreadingTelemetry.recordPhase(phase, System.nanoTime() - start);
+        }
+    }
+
+    /** Work item keyed by a stable index into the caller's ordered input. */
+    public interface IndexedTask
+    {
+        void run(int index);
+    }
+}
diff --git a/net/minecraftforge/common/threading/MainThreadDispatcher.java b/net/minecraftforge/common/threading/MainThreadDispatcher.java
new file mode 100644
index 0000000..8a38693
--- /dev/null
+++ b/net/minecraftforge/common/threading/MainThreadDispatcher.java
@@ -0,0 +1,291 @@
+/*
+ * Minecraft Forge
+ * Copyright (c) 2016-2020.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation version 2.1
+ * of the License.
+ */
+
+package net.minecraftforge.common.threading;
+
+import java.util.List;
+import java.util.concurrent.ConcurrentLinkedQueue;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.Future;
+import java.util.concurrent.TimeUnit;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+/**
+ * Legacy compatibility bridge for region workers.
+ *
+ * Existing mods use @SubscribeEvent without a thread type (MAIN). When a region worker ticks an entity that fires
+ * such an event, the handler is forwarded to the owning main/server thread and the worker blocks until it completes.
+ * The main thread pumps this queue while it waits at a region/dimension barrier, so synchronous semantics (cancel,
+ * result) are preserved without running untrusted handlers concurrently.
+ */
+public final class MainThreadDispatcher
+{
+    private static final Logger LOGGER = LogManager.getLogger("ForgeThreading");
+    private static final ConcurrentLinkedQueue<Task> QUEUE = new ConcurrentLinkedQueue<Task>();
+    private static final long DISPATCH_TIMEOUT_SECONDS = 30L;
+    private static final long FORWARD_WAIT_MILLIS =
+            Long.getLong("forge.threading.forwardWaitMs", 200L).longValue();
+    private static final java.util.concurrent.atomic.AtomicLong INLINE_FALLBACKS = new java.util.concurrent.atomic.AtomicLong();
+    private static volatile Thread owner;
+
+    private MainThreadDispatcher()
+    {
+    }
+
+    public static void markOwner()
+    {
+        owner = Thread.currentThread();
+    }
+
+    public static boolean hasOwner()
+    {
+        return owner != null;
+    }
+
+    public static boolean isOwnerThread()
+    {
+        return Thread.currentThread() == owner;
+    }
+
+    public static void dispatch(Runnable runnable)
+    {
+        Thread thread = owner;
+        if (thread == null || Thread.currentThread() == thread)
+        {
+            runnable.run();
+            return;
+        }
+
+        Task task = new Task(runnable);
+        QUEUE.add(task);
+        ThreadingTelemetry.increment("dispatch.tasks");
+        if (!task.await(FORWARD_WAIT_MILLIS, TimeUnit.MILLISECONDS))
+        {
+            // The owner is inside a region barrier and may be slow to pump; run the handler inline once. The Task's
+            // atomic guard makes this safe if the owner takes it concurrently, and prevents region stalls.
+            QUEUE.remove(task);
+            ThreadingTelemetry.increment("dispatch.fallbacks");
+            long count = INLINE_FALLBACKS.incrementAndGet();
+            if (count <= 5L || count % 1000L == 0L)
+            {
+                LOGGER.warn("[thread-dispatch] main thread did not run a forwarded handler in {} ms; running it on {} (fallback #{})",
+                        Long.valueOf(FORWARD_WAIT_MILLIS), Thread.currentThread().getName(), Long.valueOf(count));
+            }
+            task.run();
+            task.rethrow();
+        }
+        else
+        {
+            ThreadingTelemetry.increment("dispatch.forwarded");
+        }
+    }
+
+    /**
+     * Queues a task for the owner thread without waiting. Used for work that must not run on a region worker
+     * (for example entity tracker mutations) but must not stall the region barrier either.
+     */
+    public static void enqueue(Runnable runnable)
+    {
+        Thread thread = owner;
+        if (thread == null || Thread.currentThread() == thread)
+        {
+            runnable.run();
+            return;
+        }
+
+        QUEUE.add(new Task(runnable));
+        ThreadingTelemetry.increment("dispatch.tasks");
+    }
+
+    public static int getQueueSize()
+    {
+        return QUEUE.size();
+    }
+
+    public static int runPending()
+    {
+        // Only the owner may execute forwarded MAIN handlers. A dimension worker or region worker that pumps this
+        // queue would run another world's handler on the wrong thread and break the single-thread contract.
+        if (owner == null || Thread.currentThread() != owner)
+        {
+            return 0;
+        }
+
+        int executed = 0;
+        Task task;
+        while ((task = QUEUE.poll()) != null)
+        {
+            task.run();
+            executed++;
+        }
+        return executed;
+    }
+
+    /**
+     * Waits for futures while pumping forwarded MAIN-thread handlers. Used by every region/dimension barrier.
+     */
+    public static void awaitAll(List<Future<?>> futures, String what)
+    {
+        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(DISPATCH_TIMEOUT_SECONDS);
+
+        while (true)
+        {
+            runPending();
+
+            boolean allDone = true;
+            for (int index = 0; index < futures.size(); index++)
+            {
+                if (!futures.get(index).isDone())
+                {
+                    allDone = false;
+                    break;
+                }
+            }
+
+            if (allDone)
+            {
+                break;
+            }
+
+            if (System.nanoTime() > deadline)
+            {
+                throw new RuntimeException("Timed out waiting for " + what);
+            }
+
+            try
+            {
+                Thread.sleep(0L, 200000);
+            }
+            catch (InterruptedException interrupted)
+            {
+                Thread.currentThread().interrupt();
+                throw new RuntimeException("Interrupted while waiting for " + what, interrupted);
+            }
+        }
+
+        for (int index = 0; index < futures.size(); index++)
+        {
+            try
+            {
+                futures.get(index).get();
+            }
+            catch (InterruptedException interrupted)
+            {
+                Thread.currentThread().interrupt();
+                throw new RuntimeException("Interrupted while waiting for " + what, interrupted);
+            }
+            catch (java.util.concurrent.CancellationException cancelled)
+            {
+                // A path/AI task was cancelled (e.g. PathNavigate.clearPath); it is already done.
+            }
+            catch (java.util.concurrent.ExecutionException execution)
+            {
+                Throwable cause = execution.getCause();
+                if (cause instanceof RuntimeException) throw (RuntimeException)cause;
+                if (cause instanceof Error) throw (Error)cause;
+                throw new RuntimeException(cause);
+            }
+        }
+    }
+
+    /**
+     * Joins a helper thread while pumping forwarded handlers. Used by the self-test.
+     */
+    public static void join(Thread thread, long timeoutMillis)
+    {
+        long deadline = System.nanoTime() + TimeUnit.MILLISECONDS.toNanos(timeoutMillis);
+        while (thread.isAlive() && System.nanoTime() < deadline)
+        {
+            runPending();
+            try
+            {
+                Thread.sleep(1L);
+            }
+            catch (InterruptedException interrupted)
+            {
+                Thread.currentThread().interrupt();
+                return;
+            }
+        }
+    }
+
+    private static final class Task implements Runnable
+    {
+        private final Runnable delegate;
+        private final CountDownLatch done = new CountDownLatch(1);
+        private final java.util.concurrent.atomic.AtomicBoolean executed = new java.util.concurrent.atomic.AtomicBoolean();
+        private volatile Throwable error;
+
+        private Task(Runnable delegate)
+        {
+            this.delegate = delegate;
+        }
+
+        @Override
+        public void run()
+        {
+            if (!executed.compareAndSet(false, true))
+            {
+                return;
+            }
+            try
+            {
+                delegate.run();
+            }
+            catch (Throwable throwable)
+            {
+                error = throwable;
+            }
+            finally
+            {
+                done.countDown();
+            }
+        }
+
+        private boolean await(long timeout, TimeUnit unit)
+        {
+            try
+            {
+                if (!done.await(timeout, unit))
+                {
+                    return false;
+                }
+            }
+            catch (InterruptedException interrupted)
+            {
+                Thread.currentThread().interrupt();
+                return false;
+            }
+
+            rethrow();
+            return true;
+        }
+
+        private void await()
+        {
+            if (!await(DISPATCH_TIMEOUT_SECONDS, TimeUnit.SECONDS))
+            {
+                LOGGER.error("[thread-dispatch] timed out waiting for the main thread to run a forwarded handler");
+            }
+        }
+
+        private void rethrow()
+        {
+            Throwable throwable = error;
+            if (throwable != null)
+            {
+                if (throwable instanceof RuntimeException) throw (RuntimeException)throwable;
+                if (throwable instanceof Error) throw (Error)throwable;
+                throw new RuntimeException(throwable);
+            }
+        }
+    }
+}
diff --git a/net/minecraftforge/common/threading/MemoryTrim.java b/net/minecraftforge/common/threading/MemoryTrim.java
new file mode 100644
index 0000000..99aebea
--- /dev/null
+++ b/net/minecraftforge/common/threading/MemoryTrim.java
@@ -0,0 +1,86 @@
+package net.minecraftforge.common.threading;
+
+import java.lang.reflect.Field;
+import java.util.Map;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+/**
+ * Low-memory helpers. Forge's LaunchClassLoader keeps the transformed bytecode of every loaded class in
+ * {@code resourceCache}; on a large 1.12.2 pack that is hundreds of megabytes of {@code byte[]} that stays live
+ * forever. Once the startup model/texture classes are loaded the bytes can be re-read on demand, so dropping the
+ * cache is safe and releases a large contiguous block before texture decoding peaks.
+ */
+public final class MemoryTrim
+{
+    private static final Logger LOGGER = LogManager.getLogger("ForgeThreading");
+    private static volatile boolean trimmed;
+    private static volatile long nextTrimAt;
+
+    private MemoryTrim()
+    {
+    }
+
+    public static boolean isLowMemory()
+    {
+        return Runtime.getRuntime().maxMemory() <= 1280L * 1024L * 1024L;
+    }
+
+    public static boolean isTrimmed()
+    {
+        return trimmed;
+    }
+
+    /** Called from the client loop; drops bytecode loaded since the last pass without touching loaded classes. */
+    public static void trimIfDue()
+    {
+        if (!isLowMemory())
+        {
+            return;
+        }
+        long now = System.currentTimeMillis();
+        if (now < nextTrimAt)
+        {
+            return;
+        }
+        nextTrimAt = now + 30000L;
+        trimLaunchClassLoaderCache();
+    }
+
+    public static void trimLaunchClassLoaderCache()
+    {
+        if (!isLowMemory())
+        {
+            return;
+        }
+
+        try
+        {
+            Class<?> launch = Class.forName("net.minecraft.launchwrapper.Launch");
+            Object loader = launch.getField("classLoader").get(null);
+            if (loader == null)
+            {
+                return;
+            }
+
+            Field field = loader.getClass().getDeclaredField("resourceCache");
+            field.setAccessible(true);
+            Object value = field.get(loader);
+            if (value instanceof Map)
+            {
+                Map<?, ?> cache = (Map<?, ?>)value;
+                int size = cache.size();
+                cache.clear();
+                trimmed = true;
+                if (size > 0)
+                {
+                    LOGGER.info("[low-memory] cleared LaunchClassLoader byte cache: {} entries", Integer.valueOf(size));
+                }
+            }
+        }
+        catch (Throwable throwable)
+        {
+            LOGGER.warn("[low-memory] class byte cache trim failed", throwable);
+        }
+    }
+}
diff --git a/net/minecraftforge/common/threading/PacketSerialization.java b/net/minecraftforge/common/threading/PacketSerialization.java
new file mode 100644
index 0000000..4d31354
--- /dev/null
+++ b/net/minecraftforge/common/threading/PacketSerialization.java
@@ -0,0 +1,138 @@
+/*
+ * Minecraft Forge
+ * Copyright (c) 2016-2020.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation version 2.1
+ * of the License.
+ */
+
+package net.minecraftforge.common.threading;
+
+import java.util.Queue;
+import java.util.concurrent.ConcurrentLinkedQueue;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ThreadFactory;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicLong;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+/**
+ * Per-player ordered packet serialization off the game thread.
+ *
+ * Every NetworkManager owns one {@link Serial} queue. The queue runs serially per player (packet order is preserved)
+ * on a shared daemon pool. Eligible PLAY-state packets are written to a ByteBuf on the pool and then handed to
+ * Netty, which only has to compress/encrypt/frame them. FML proxy packets and state transitions are dispatched
+ * through the same serial queue so they cannot overtake already-queued packets.
+ *
+ * Local (single-player) channels bypass this path entirely: they transfer Packet objects in memory and have no
+ * encoder pipeline.
+ *
+ * -Dforge.threading.packetSerialization=false disables it; singleThreaded also disables it.
+ */
+public final class PacketSerialization
+{
+    private static final Logger LOGGER = LogManager.getLogger("ForgeThreading");
+    private static final boolean ENABLED = !Threading.isSingleThreaded() &&
+            Boolean.parseBoolean(System.getProperty("forge.threading.packetSerialization", "true"));
+    private static final int THREADS = Math.max(1, Math.min(8, Integer.getInteger(
+            "forge.threading.packetSerializationThreads",
+            Math.max(1, Runtime.getRuntime().availableProcessors() / 2)).intValue()));
+    private static final AtomicInteger IDS = new AtomicInteger();
+    private static final AtomicLong SERIALIZED = new AtomicLong();
+    private static final ExecutorService POOL = Executors.newFixedThreadPool(THREADS, new ThreadFactory()
+    {
+        @Override
+        public Thread newThread(Runnable runnable)
+        {
+            Thread thread = new Thread(net.minecraftforge.fml.common.thread.SidedThreadGroups.SERVER,
+                    runnable, "Packet Serializer #" + IDS.incrementAndGet());
+            thread.setDaemon(true);
+            return thread;
+        }
+    });
+
+    static
+    {
+        ThreadingTelemetry.registerPool("packetOut", POOL);
+    }
+
+    private PacketSerialization()
+    {
+    }
+
+    public static boolean isEnabled()
+    {
+        return ENABLED;
+    }
+
+    public static Serial newSerial()
+    {
+        return new Serial();
+    }
+
+    public static void recordSerialized()
+    {
+        ThreadingTelemetry.increment("net.out");
+        long count = SERIALIZED.incrementAndGet();
+        if (count % 1000L == 0L)
+        {
+            LOGGER.info("[packet-serialization] serialized {} packets on {} threads", Long.valueOf(count),
+                    Integer.valueOf(THREADS));
+        }
+    }
+
+    /**
+     * A serial executor: tasks for one player run in submission order on the shared pool, and only one worker
+     * drains a player's queue at a time.
+     */
+    public static final class Serial
+    {
+        private final Queue<Runnable> tasks = new ConcurrentLinkedQueue<Runnable>();
+        private final AtomicBoolean draining = new AtomicBoolean();
+
+        private Serial()
+        {
+        }
+
+        public void execute(Runnable task)
+        {
+            this.tasks.add(task);
+            if (this.draining.compareAndSet(false, true))
+            {
+                POOL.execute(this::drain);
+            }
+        }
+
+        private void drain()
+        {
+            try
+            {
+                Runnable task;
+                while ((task = this.tasks.poll()) != null)
+                {
+                    try
+                    {
+                        task.run();
+                    }
+                    catch (Throwable throwable)
+                    {
+                        LOGGER.error("[packet-serialization] task failed", throwable);
+                    }
+                }
+            }
+            finally
+            {
+                this.draining.set(false);
+                if (!this.tasks.isEmpty() && this.draining.compareAndSet(false, true))
+                {
+                    POOL.execute(this::drain);
+                }
+            }
+        }
+    }
+}
diff --git a/net/minecraftforge/common/threading/PathfindingExecutor.java b/net/minecraftforge/common/threading/PathfindingExecutor.java
new file mode 100644
index 0000000..c5d30f0
--- /dev/null
+++ b/net/minecraftforge/common/threading/PathfindingExecutor.java
@@ -0,0 +1,211 @@
+/*
+ * Minecraft Forge
+ * Copyright (c) 2016-2020.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation version 2.1
+ * of the License.
+ */
+
+package net.minecraftforge.common.threading;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Set;
+import java.util.concurrent.Callable;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.FutureTask;
+import java.util.concurrent.ThreadFactory;
+import java.util.concurrent.atomic.AtomicInteger;
+import net.minecraft.pathfinding.Path;
+import net.minecraft.world.World;
+
+/**
+ * Dedicated pool for asynchronous path searches.
+ *
+ * Enabled with -Dforge.threading.asyncPathfinding=true. PathNavigate builds a ChunkCache on the calling thread and
+ * submits the search; on the next AI update it picks up the finished Path. All path futures are joined before the
+ * next block tick phase (MinecraftServer.tickWorld), so searches never read chunks while blocks are being mutated.
+ */
+public final class PathfindingExecutor
+{
+    private static final org.apache.logging.log4j.Logger LOGGER = org.apache.logging.log4j.LogManager.getLogger("ForgeThreading");
+    private static final AtomicInteger IDS = new AtomicInteger();
+    private static final java.util.concurrent.atomic.AtomicLong SUBMITTED = new java.util.concurrent.atomic.AtomicLong();
+    private static final java.util.concurrent.atomic.AtomicLong COMPLETED = new java.util.concurrent.atomic.AtomicLong();
+    private static volatile boolean logged;
+    private static final Set<Future<?>> ACTIVE_SERVER = Collections.newSetFromMap(new ConcurrentHashMap<Future<?>, Boolean>());
+    private static final Set<Future<?>> ACTIVE_CLIENT = Collections.newSetFromMap(new ConcurrentHashMap<Future<?>, Boolean>());
+    private static volatile ExecutorService pool;
+
+    private PathfindingExecutor()
+    {
+    }
+
+    public static boolean isEnabled()
+    {
+        return Threading.isAsyncPathfindingEnabled();
+    }
+
+    public static Future<Path> submit(final World world, final Region region, final long tickId, final Callable<Path> search)
+    {
+        FutureTask<Path> task = new FutureTask<Path>(new Callable<Path>()
+        {
+            @Override
+            public Path call() throws Exception
+            {
+                BackgroundPacer.yieldIfNeeded();
+                TickContext context = TickContext.getOrCreate();
+                context.setWorld(world);
+                context.setRegion(region != null ? region : Region.wholeDimension(world.provider.getDimension()));
+                context.setPhase(TickPhase.ENTITIES);
+                context.setTickId(tickId);
+                try
+                {
+                    return search.call();
+                }
+                finally
+                {
+                    COMPLETED.incrementAndGet();
+                    ThreadingTelemetry.increment("path.completed");
+                    ThreadingMetrics.recordPathfindingComplete();
+                    TickContext.clear();
+                }
+            }
+        });
+
+        SUBMITTED.incrementAndGet();
+        ThreadingTelemetry.increment("path.submitted");
+        ThreadingMetrics.recordPathfindingSubmit();
+        if (!logged)
+        {
+            logged = true;
+            LOGGER.info("Async pathfinding: pool of {} threads", Integer.valueOf(Threading.getPathfindingThreads()));
+        }
+
+        Set<Future<?>> active = world.isRemote ? ACTIVE_CLIENT : ACTIVE_SERVER;
+        active.add(task);
+        getPool().execute(task);
+        return task;
+    }
+
+    /**
+     * Waits for all submitted searches and pumps forwarded MAIN handlers. Called before TE/block phases and before
+     * the next world tick.
+     */
+    public static void awaitAll()
+    {
+        await(ACTIVE_SERVER);
+        await(ACTIVE_CLIENT);
+    }
+
+    public static void awaitAllServer()
+    {
+        await(ACTIVE_SERVER);
+    }
+
+    public static void awaitAllClient()
+    {
+        await(ACTIVE_CLIENT);
+    }
+
+    /**
+     * Drops completed client path futures without blocking the client thread. PathNavigate picks up a finished
+     * pending path on its next AI update, so waiting for every search before each render frame is unnecessary and
+     * was the main cost inside Minecraft's scheduledExecutables section.
+     */
+    public static int reapCompletedClient()
+    {
+        return reapCompleted(ACTIVE_CLIENT);
+    }
+
+    private static int reapCompleted(Set<Future<?>> active)
+    {
+        if (active.isEmpty())
+        {
+            return 0;
+        }
+
+        int reaped = 0;
+        for (Future<?> future : new ArrayList<Future<?>>(active))
+        {
+            if (future.isDone())
+            {
+                active.remove(future);
+                ++reaped;
+            }
+        }
+        return reaped;
+    }
+
+    private static void await(Set<Future<?>> active)
+    {
+        if (active.isEmpty())
+        {
+            return;
+        }
+
+        List<Future<?>> pending = new ArrayList<Future<?>>(active);
+        MainThreadDispatcher.awaitAll(pending, "pathfinding");
+        for (int index = 0; index < pending.size(); index++)
+        {
+            active.remove(pending.get(index));
+        }
+    }
+
+    public static long getSubmittedCount()
+    {
+        return SUBMITTED.get();
+    }
+
+    public static long getCompletedCount()
+    {
+        return COMPLETED.get();
+    }
+
+    public static void shutdown()
+    {
+        ExecutorService executor = pool;
+        if (executor != null)
+        {
+            executor.shutdownNow();
+            pool = null;
+        }
+        ACTIVE_SERVER.clear();
+        ACTIVE_CLIENT.clear();
+    }
+
+    private static ExecutorService getPool()
+    {
+        ExecutorService executor = pool;
+        if (executor == null)
+        {
+            synchronized (PathfindingExecutor.class)
+            {
+                executor = pool;
+                if (executor == null)
+                {
+                    executor = Executors.newFixedThreadPool(Threading.getPathfindingThreads(), new ThreadFactory()
+                    {
+                        @Override
+                        public Thread newThread(Runnable runnable)
+                        {
+                            Thread thread = new Thread(net.minecraftforge.fml.common.thread.SidedThreadGroups.SERVER,
+                                    runnable, "Pathfinding Thread #" + IDS.incrementAndGet());
+                            thread.setDaemon(true);
+                            return thread;
+                        }
+                    });
+                    pool = executor;
+                    ThreadingTelemetry.registerPool("path", executor);
+                }
+            }
+        }
+        return executor;
+    }
+}
diff --git a/net/minecraftforge/common/threading/PerformanceGovernor.java b/net/minecraftforge/common/threading/PerformanceGovernor.java
new file mode 100644
index 0000000..c24ff03
--- /dev/null
+++ b/net/minecraftforge/common/threading/PerformanceGovernor.java
@@ -0,0 +1,148 @@
+/*
+ * Minecraft Forge
+ * Copyright (c) 2016-2020.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation version 2.1
+ * of the License.
+ */
+
+package net.minecraftforge.common.threading;
+
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+/**
+ * Self-tuning server governor.
+ *
+ * It watches the rolling MSPT window produced by {@link ThreadingMetrics}. When the server is consistently over
+ * budget it shrinks the deterministic AI-LOD radii and the simulation distance; when it has been comfortably under
+ * budget for a while it expands them back. Near players always remain at full tick rate.
+ *
+ * This is intentionally pack-agnostic: no per-modpack configuration is required. Hysteresis (2 bad windows to
+ * shrink, 10 good windows to expand) and a 10-window warm-up prevent the initial world-load spike from triggering it.
+ *
+ * -Dforge.threading.governor=false disables it.
+ */
+public final class PerformanceGovernor
+{
+    private static final Logger LOGGER = LogManager.getLogger("ForgeThreading");
+    private static final boolean ENABLED = Boolean.parseBoolean(System.getProperty("forge.threading.governor", "true"));
+    private static final double HIGH_MSPT = Double.parseDouble(System.getProperty("forge.threading.governorHighMspt", "40"));
+    private static final double HIGH_MAX = Double.parseDouble(System.getProperty("forge.threading.governorHighMaxMspt", "120"));
+    private static final double LOW_MSPT = Double.parseDouble(System.getProperty("forge.threading.governorLowMspt", "20"));
+    private static final double LOW_MAX = Double.parseDouble(System.getProperty("forge.threading.governorLowMaxMspt", "60"));
+    private static final int WARMUP_WINDOWS = Integer.getInteger("forge.threading.governorWarmupWindows", 10).intValue();
+    private static final int SHRINK_AFTER = Math.max(1, Integer.getInteger("forge.threading.governorShrinkAfter", 2).intValue());
+    private static final int EXPAND_AFTER = Math.max(1, Integer.getInteger("forge.threading.governorExpandAfter", 10).intValue());
+    private static final int DEFAULT_NEAR = 48;
+    private static final int DEFAULT_MID = 96;
+    private static final int DEFAULT_FAR = 160;
+    private static final int DEFAULT_SIM = 12;
+    private static final int MIN_NEAR = 24;
+    private static final int MIN_MID = 48;
+    private static final int MIN_FAR = 80;
+    private static final int MIN_SIM = 8;
+    private static volatile int windows;
+    private static volatile int badWindows;
+    private static volatile int goodWindows;
+    private static volatile long actions;
+
+    private PerformanceGovernor()
+    {
+    }
+
+    public static void onMetricsWindow(double avgMspt, double maxMspt)
+    {
+        if (!ENABLED || !Threading.isRegionTickingEnabled()
+                || !Boolean.parseBoolean(System.getProperty("forge.threading.entityLod", "true")))
+        {
+            return;
+        }
+
+        windows++;
+        if (windows <= WARMUP_WINDOWS)
+        {
+            return;
+        }
+
+        boolean high = avgMspt > HIGH_MSPT || maxMspt > HIGH_MAX;
+        boolean low = avgMspt < LOW_MSPT && maxMspt < LOW_MAX;
+
+        if (high)
+        {
+            badWindows++;
+            goodWindows = 0;
+        }
+        else if (low)
+        {
+            goodWindows++;
+            badWindows = 0;
+        }
+        else
+        {
+            badWindows = 0;
+            goodWindows = 0;
+        }
+
+        if (badWindows >= SHRINK_AFTER)
+        {
+            badWindows = 0;
+            shrink(avgMspt, maxMspt);
+        }
+        else if (goodWindows >= EXPAND_AFTER)
+        {
+            goodWindows = 0;
+            expand(avgMspt, maxMspt);
+        }
+    }
+
+    private static void shrink(double avgMspt, double maxMspt)
+    {
+        int oldNear = RegionManager.getLodNear();
+        int oldMid = RegionManager.getLodMid();
+        int oldFar = RegionManager.getLodFar();
+        int oldSim = Threading.getDynamicSimulationDistance();
+        int near = Math.max(MIN_NEAR, oldNear * 3 / 4);
+        int mid = Math.max(near + 16, oldMid * 3 / 4);
+        int far = Math.max(mid + 16, oldFar * 3 / 4);
+        int sim = Math.max(MIN_SIM, oldSim - 1);
+
+        if (near == oldNear && mid == oldMid && far == oldFar && sim == oldSim)
+        {
+            return;
+        }
+
+        RegionManager.setLodRadii(near, mid, far);
+        Threading.setDynamicSimulationDistance(sim);
+        actions++;
+        LOGGER.warn("[governor] mspt avg={} max={} -> LOD {}/{}/{} sim {} (action #{})",
+                Double.valueOf(avgMspt), Double.valueOf(maxMspt), Integer.valueOf(near), Integer.valueOf(mid),
+                Integer.valueOf(far), Integer.valueOf(sim), Long.valueOf(actions));
+    }
+
+    private static void expand(double avgMspt, double maxMspt)
+    {
+        int oldNear = RegionManager.getLodNear();
+        int oldMid = RegionManager.getLodMid();
+        int oldFar = RegionManager.getLodFar();
+        int oldSim = Threading.getDynamicSimulationDistance();
+        int near = Math.min(DEFAULT_NEAR, oldNear + 2);
+        int mid = Math.min(DEFAULT_MID, oldMid + 4);
+        int far = Math.min(DEFAULT_FAR, oldFar + 8);
+        int sim = Math.min(DEFAULT_SIM, oldSim + 1);
+
+        if (near == oldNear && mid == oldMid && far == oldFar && sim == oldSim)
+        {
+            return;
+        }
+
+        RegionManager.setLodRadii(near, mid, far);
+        Threading.setDynamicSimulationDistance(sim);
+        actions++;
+        LOGGER.info("[governor] mspt avg={} max={} -> LOD {}/{}/{} sim {} (action #{})",
+                Double.valueOf(avgMspt), Double.valueOf(maxMspt), Integer.valueOf(near), Integer.valueOf(mid),
+                Integer.valueOf(far), Integer.valueOf(sim), Long.valueOf(actions));
+    }
+}
diff --git a/net/minecraftforge/common/threading/PregenManager.java b/net/minecraftforge/common/threading/PregenManager.java
