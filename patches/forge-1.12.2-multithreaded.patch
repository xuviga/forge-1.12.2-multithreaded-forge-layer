+ */
+
+package net.minecraftforge.common.threading;
+
+import java.io.File;
+import java.io.IOException;
+import java.util.Collections;
+import java.util.List;
+import javax.annotation.Nullable;
+import net.minecraft.command.CommandBase;
+import net.minecraft.command.CommandException;
+import net.minecraft.command.ICommandSender;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.util.math.BlockPos;
+import net.minecraft.util.text.TextComponentString;
+
+/**
+ * /forgethreading [status|overlay on|off|dump|reset]
+ *
+ * Status prints TPS/MSPT, pool sizes/queues, main-thread phase costs and fallback counters. Overlay toggles the F3
+ * lines. Dump writes the same detailed snapshot to logs/forgethreading-<timestamp>.txt.
+ */
+public class CommandForgeThreading extends CommandBase
+{
+    @Override
+    public String getName()
+    {
+        return "forgethreading";
+    }
+
+    @Override
+    public String getUsage(ICommandSender sender)
+    {
+        return "/forgethreading [status|overlay on|off|handlers|dump|reset]";
+    }
+
+    @Override
+    public int getRequiredPermissionLevel()
+    {
+        return 2;
+    }
+
+    @Override
+    public void execute(MinecraftServer server, ICommandSender sender, String[] args) throws CommandException
+    {
+        if (args.length == 0 || "status".equalsIgnoreCase(args[0]))
+        {
+            sendLines(sender, ThreadingTelemetry.getDetailedLines());
+            return;
+        }
+
+        if ("overlay".equalsIgnoreCase(args[0]))
+        {
+            if (args.length == 1)
+            {
+                sender.sendMessage(new TextComponentString("overlay=" + ThreadingTelemetry.isOverlayEnabled()));
+                return;
+            }
+            if ("on".equalsIgnoreCase(args[1]))
+            {
+                ThreadingTelemetry.setOverlayEnabled(true);
+                sender.sendMessage(new TextComponentString("ForgeThreading F3 overlay enabled"));
+                return;
+            }
+            if ("off".equalsIgnoreCase(args[1]))
+            {
+                ThreadingTelemetry.setOverlayEnabled(false);
+                sender.sendMessage(new TextComponentString("ForgeThreading F3 overlay disabled"));
+                return;
+            }
+            throw new CommandException(getUsage(sender));
+        }
+
+        if ("handlers".equalsIgnoreCase(args[0]))
+        {
+            sender.sendMessage(new TextComponentString("Inbound PLAY audit (static):"));
+            sender.sendMessage(new TextComponentString(" server: 29 handlers, 27 call PacketThreadUtil; offload: handleResourcePackStatus, processKeepAlive"));
+            sender.sendMessage(new TextComponentString(" client: 76 handlers, 72 call PacketThreadUtil; offload: handleDisconnect, handlePlayerListHeaderFooter, handleKeepAlive, handleResourcePack"));
+            sender.sendMessage(new TextComponentString(" offloaded handlers are ack/UI-state/keepalive/resource-pack paths; world/player mutation handlers forward to the game thread"));
+            return;
+        }
+
+        if ("dump".equalsIgnoreCase(args[0]))
+        {
+            try
+            {
+                File file = ThreadingTelemetry.dumpToFile();
+                sender.sendMessage(new TextComponentString("ForgeThreading dump: " + file.getAbsolutePath()));
+            }
+            catch (IOException exception)
+            {
+                throw new CommandException("Could not write telemetry dump: " + exception.getMessage());
+            }
+            return;
+        }
+
+        if ("reset".equalsIgnoreCase(args[0]))
+        {
+            ThreadingTelemetry.resetCounters();
+            sender.sendMessage(new TextComponentString("ForgeThreading counters and phases reset"));
+            return;
+        }
+
+        throw new CommandException(getUsage(sender));
+    }
+
+    private static void sendLines(ICommandSender sender, List<String> lines)
+    {
+        for (int index = 0; index < lines.size(); index++)
+        {
+            sender.sendMessage(new TextComponentString(lines.get(index)));
+        }
+    }
+
+    @Override
+    public List<String> getTabCompletions(MinecraftServer server, ICommandSender sender, String[] args, @Nullable BlockPos targetPos)
+    {
+        if (args.length == 1)
+        {
+            return getListOfStringsMatchingLastWord(args, "status", "overlay", "handlers", "dump", "reset");
+        }
+        if (args.length == 2 && "overlay".equalsIgnoreCase(args[0]))
+        {
+            return getListOfStringsMatchingLastWord(args, "on", "off");
+        }
+        return Collections.emptyList();
+    }
+}
diff --git a/net/minecraftforge/common/threading/DeferredMutationQueue.java b/net/minecraftforge/common/threading/DeferredMutationQueue.java
new file mode 100644
index 0000000..b4d0693
--- /dev/null
+++ b/net/minecraftforge/common/threading/DeferredMutationQueue.java
@@ -0,0 +1,140 @@
+/*
+ * Minecraft Forge
+ * Copyright (c) 2016-2020.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation version 2.1
+ * of the License.
+ */
+
+package net.minecraftforge.common.threading;
+
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.ConcurrentLinkedQueue;
+import java.util.concurrent.ConcurrentSkipListMap;
+
+/**
+ * Ordered, coalescing hand-off for mutations produced by a non-owner thread.
+ *
+ * Region workers enqueue with a deterministic order key (regionId, phase, per-context sequence), so the owner
+ * applies cross-region effects in a replay-stable order regardless of which worker finished first. Legacy
+ * (non-region) enqueues keep FIFO order with last-write-wins coalescing per key and are drained after the ordered set.
+ */
+public final class DeferredMutationQueue
+{
+    public interface Mutation
+    {
+        /** Coalescing key, or null when every occurrence must be applied. */
+        Object getKey();
+
+        void apply();
+    }
+
+    private final ConcurrentSkipListMap<Long, Mutation> ordered = new ConcurrentSkipListMap<Long, Mutation>();
+    private final ConcurrentHashMap<Object, Long> latestOrdered = new ConcurrentHashMap<Object, Long>();
+    private final ConcurrentLinkedQueue<Mutation> legacy = new ConcurrentLinkedQueue<Mutation>();
+    private final ConcurrentHashMap<Object, Mutation> latestLegacy = new ConcurrentHashMap<Object, Mutation>();
+
+    public void enqueue(Mutation mutation)
+    {
+        ThreadingTelemetry.increment("deferred.legacy.enqueued");
+        Object key = mutation.getKey();
+        if (key != null)
+        {
+            // Last write wins for the same position, matching the ordered queue and avoiding duplicate block/TE
+            // work when several legacy callers touch the same position in one tick.
+            Mutation previous = latestLegacy.put(key, mutation);
+            if (previous != null)
+            {
+                ThreadingTelemetry.increment("deferred.legacy.coalesced");
+                legacy.remove(previous);
+            }
+        }
+        legacy.add(mutation);
+    }
+
+    public void enqueueOrdered(long order, Mutation mutation)
+    {
+        ThreadingTelemetry.increment("deferred.ordered.enqueued");
+        Object key = mutation.getKey();
+        if (key != null)
+        {
+            Long previous = latestOrdered.put(key, Long.valueOf(order));
+            if (previous != null)
+            {
+                ThreadingTelemetry.increment("deferred.ordered.coalesced");
+                ordered.remove(previous);
+            }
+        }
+        ordered.put(Long.valueOf(order), mutation);
+    }
+
+    public int drain(int max)
+    {
+        int applied = 0;
+
+        while (applied < max)
+        {
+            Map.Entry<Long, Mutation> entry = ordered.pollFirstEntry();
+            if (entry == null)
+            {
+                break;
+            }
+            Mutation mutation = entry.getValue();
+            Object key = mutation.getKey();
+            if (key != null)
+            {
+                latestOrdered.remove(key, entry.getKey());
+            }
+            mutation.apply();
+            ThreadingTelemetry.increment("deferred.ordered.applied");
+            applied++;
+        }
+
+        while (applied < max)
+        {
+            Mutation mutation = legacy.poll();
+            if (mutation == null)
+            {
+                break;
+            }
+            Object key = mutation.getKey();
+            if (key != null && !latestLegacy.remove(key, mutation))
+            {
+                // A newer mutation for the same key superseded this one after it was queued.
+                ThreadingTelemetry.increment("deferred.legacy.stale");
+                continue;
+            }
+            mutation.apply();
+            ThreadingTelemetry.increment("deferred.legacy.applied");
+            applied++;
+        }
+
+        return applied;
+    }
+
+    public int drainAll()
+    {
+        return drain(Integer.MAX_VALUE);
+    }
+
+    public int size()
+    {
+        return ordered.size() + legacy.size();
+    }
+
+    public boolean isEmpty()
+    {
+        return ordered.isEmpty() && legacy.isEmpty();
+    }
+
+    public void clear()
+    {
+        ordered.clear();
+        latestOrdered.clear();
+        legacy.clear();
+        latestLegacy.clear();
+    }
+}
diff --git a/net/minecraftforge/common/threading/ExplosionSelfTest.java b/net/minecraftforge/common/threading/ExplosionSelfTest.java
