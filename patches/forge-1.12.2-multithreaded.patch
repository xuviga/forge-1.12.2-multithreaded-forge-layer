+package net.minecraft.world.gen.layer;
+
+import com.google.common.collect.Lists;
+import java.util.List;
+
+public class IntCache
+{
+    /**
+     * Vanilla kept these buffers in static fields. Terrain generation is moving to worker threads, so each thread
+     * must own its cache or concurrent layer passes will hand the same int[] to two chunks.
+     */
+    private static final class Cache
+    {
+        private int intCacheSize = 256;
+        private final List<int[]> freeSmallArrays = Lists.<int[]>newArrayList();
+        private final List<int[]> inUseSmallArrays = Lists.<int[]>newArrayList();
+        private final List<int[]> freeLargeArrays = Lists.<int[]>newArrayList();
+        private final List<int[]> inUseLargeArrays = Lists.<int[]>newArrayList();
+    }
+
+    private static final ThreadLocal<Cache> CACHE = new ThreadLocal<Cache>()
+    {
+        @Override
+        protected Cache initialValue()
+        {
+            return new Cache();
+        }
+    };
+
+    public static int[] getIntCache(int size)
+    {
+        Cache cache = CACHE.get();
+
+        if (size <= 256)
+        {
+            if (cache.freeSmallArrays.isEmpty())
+            {
+                int[] aint4 = new int[256];
+                cache.inUseSmallArrays.add(aint4);
+                return aint4;
+            }
+            else
+            {
+                int[] aint3 = cache.freeSmallArrays.remove(cache.freeSmallArrays.size() - 1);
+                cache.inUseSmallArrays.add(aint3);
+                return aint3;
+            }
+        }
+        else if (size > cache.intCacheSize)
+        {
+            cache.intCacheSize = size;
+            cache.freeLargeArrays.clear();
+            cache.inUseLargeArrays.clear();
+            int[] aint2 = new int[cache.intCacheSize];
+            cache.inUseLargeArrays.add(aint2);
+            return aint2;
+        }
+        else if (cache.freeLargeArrays.isEmpty())
+        {
+            int[] aint1 = new int[cache.intCacheSize];
+            cache.inUseLargeArrays.add(aint1);
+            return aint1;
+        }
+        else
+        {
+            int[] aint = cache.freeLargeArrays.remove(cache.freeLargeArrays.size() - 1);
+            cache.inUseLargeArrays.add(aint);
+            return aint;
+        }
+    }
+
+    /**
+     * Mark all pre-allocated arrays as available for re-use by moving them to the appropriate free lists.
+     */
+    public static void resetIntCache()
+    {
+        Cache cache = CACHE.get();
+
+        if (!cache.freeLargeArrays.isEmpty())
+        {
+            cache.freeLargeArrays.remove(cache.freeLargeArrays.size() - 1);
+        }
+
+        if (!cache.freeSmallArrays.isEmpty())
+        {
+            cache.freeSmallArrays.remove(cache.freeSmallArrays.size() - 1);
+        }
+
+        cache.freeLargeArrays.addAll(cache.inUseLargeArrays);
+        cache.freeSmallArrays.addAll(cache.inUseSmallArrays);
+        cache.inUseLargeArrays.clear();
+        cache.inUseSmallArrays.clear();
+    }
+
+    /**
+     * Gets a human-readable string that indicates the sizes of all the cache fields.  Basically a synchronized static
+     * toString.
+     */
+    public static String getCacheSizes()
+    {
+        Cache cache = CACHE.get();
+        return "cache: " + cache.freeLargeArrays.size() + ", tcache: " + cache.freeSmallArrays.size() + ", allocated: " + cache.inUseLargeArrays.size() + ", tallocated: " + cache.inUseSmallArrays.size();
+    }
+}
