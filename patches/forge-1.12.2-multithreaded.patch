+     * on demand (BufferBuilder#growBuffer), so a section that really is huge still works.
+     */
+    private static final int SOLID_INITIAL_INTS = Math.max(4096,
+            Integer.getInteger("forge.threading.solidBufferInts", 262144).intValue());
+    private static final int CUTOUT_INITIAL_INTS = Math.max(4096,
+            Integer.getInteger("forge.threading.cutoutBufferInts", 32768).intValue());
+    private static final int TRANSLUCENT_INITIAL_INTS = Math.max(4096,
+            Integer.getInteger("forge.threading.translucentBufferInts", 65536).intValue());
+
