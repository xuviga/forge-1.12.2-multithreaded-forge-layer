+        if (this.leftClickCounter <= 0 && !this.player.isHandActive())
+        {
+            if (leftClick && this.objectMouseOver != null && this.objectMouseOver.typeOfHit == RayTraceResult.Type.BLOCK)
+            {
+                BlockPos blockpos = this.objectMouseOver.getBlockPos();
