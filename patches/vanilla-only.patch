+                        switch (this.objectMouseOver.typeOfHit)
+                        {
+                            case ENTITY:
+
+                                if (this.playerController.interactWithEntity(this.player, this.objectMouseOver.entityHit, this.objectMouseOver, enumhand) == EnumActionResult.SUCCESS)
