+    private static boolean isCacheable(IBakedModel model)
+    {
+        return isCacheable(model, 0);
+    }
+
+    private static boolean isCacheable(IBakedModel model, int depth)
+    {
+        if (depth > 8 || model == null)
+        {
+            return false;
+        }
+        if (model.getClass() == SimpleBakedModel.class || model.getClass() == BuiltInModel.class)
+        {
+            return model.getOverrides() == ItemOverrideList.NONE;
+        }
+        if (model.getClass() == WeightedBakedModel.class)
+        {
+            if (model.getOverrides() != ItemOverrideList.NONE)
+            {
+                return false;
+            }
+            for (WeightedBakedModel.WeightedModel entry : ((WeightedBakedModel)model).getModelsForCache())
+            {
+                if (!isCacheable(entry.model, depth + 1))
+                {
+                    return false;
+                }
+            }
+            return true;
+        }
+        return isForgeFlattenable(model) && hasAnyQuads(model);
+    }
+
+    private static boolean isForgeFlattenable(IBakedModel model)
+    {
+        String name = model.getClass().getName();
+        if (name.equals("net.minecraftforge.client.model.ModelLoader$VanillaModelWrapper$1"))
+        {
+            return true;
+        }
+        if (name.equals("net.minecraftforge.client.model.BakedItemModel")
+                || name.equals("net.minecraftforge.client.model.MultiModel$Baked"))
+        {
+            return model.getOverrides() == ItemOverrideList.NONE;
+        }
+        return false;
+    }
