+    private static IBakedModel deserializeModel(byte[] data, TextureMap textureMap) throws IOException
+    {
+        return deserializeModel(data, textureMap, 0);
+    }
+
+    private static IBakedModel deserializeModel(byte[] data, TextureMap textureMap, int depth) throws IOException
+    {
+        if (depth > 8)
+        {
+            return null;
+        }
+        try (DataInputStream in = new DataInputStream(new ByteArrayInputStream(data)))
+        {
+            int type = in.readUnsignedByte();
+            if (type == 2)
+            {
+                int count = in.readInt();
+                List<WeightedBakedModel.WeightedModel> entries = new ArrayList<WeightedBakedModel.WeightedModel>(count);
+                for (int index = 0; index < count; index++)
+                {
+                    int weight = in.readInt();
+                    int length = in.readInt();
+                    byte[] sub = new byte[length];
+                    in.readFully(sub);
+                    IBakedModel subModel = deserializeModel(sub, textureMap, depth + 1);
+                    if (subModel == null)
+                    {
+                        return null;
+                    }
+                    entries.add(new WeightedBakedModel.WeightedModel(subModel, weight));
+                }
+                return new WeightedBakedModel(entries);
+            }
+
+            ItemCameraTransforms transforms = readTransforms(in);
+            if (type == 1)
+            {
+                return new BuiltInModel(transforms, ItemOverrideList.NONE);
+            }
+            if (type != 0)
+            {
+                return null;
+            }
+
+            boolean ambient = in.readBoolean();
+            boolean gui3d = in.readBoolean();
+            String particleName = in.readUTF();
+            TextureAtlasSprite particle = particleName.isEmpty() ? null : textureMap.getAtlasSprite(particleName);
+            List<BakedQuad> general = readQuads(in, textureMap);
+            Map<EnumFacing, List<BakedQuad>> faces = new EnumMap<EnumFacing, List<BakedQuad>>(EnumFacing.class);
+            for (EnumFacing facing : EnumFacing.values())
+            {
+                faces.put(facing, readQuads(in, textureMap));
+            }
+            return new SimpleBakedModel(general, faces, ambient, gui3d, particle, transforms, ItemOverrideList.NONE);
+        }
+        catch (Throwable throwable)
+        {
+            return null;
+        }
+    }
+
+    private static void writeQuads(DataOutputStream out, List<BakedQuad> quads) throws IOException
+    {
+        if (quads == null)
+        {
+            out.writeInt(0);
+            return;
+        }
+        out.writeInt(quads.size());
+        for (BakedQuad quad : quads)
+        {
+            writeQuad(out, quad);
+        }
+    }
+
+    private static List<BakedQuad> readQuads(DataInputStream in, TextureMap textureMap) throws IOException
+    {
+        int count = in.readInt();
+        List<BakedQuad> quads = Lists.newArrayListWithCapacity(count);
+        for (int index = 0; index < count; index++)
+        {
+            quads.add(readQuad(in, textureMap));
+        }
+        return quads;
+    }
+
+    private static void writeQuad(DataOutputStream out, BakedQuad quad) throws IOException
+    {
+        int[] vertexData = quad.getVertexData();
+        out.writeInt(vertexData.length);
+        for (int value : vertexData)
+        {
+            out.writeInt(value);
+        }
+        out.writeInt(quad.getTintIndex());
+        EnumFacing face = quad.getFace();
+        out.writeByte(face == null ? -1 : face.ordinal());
+        TextureAtlasSprite sprite = quad.getSprite();
+        out.writeUTF(sprite == null ? "" : sprite.getIconName());
+        out.writeBoolean(quad.shouldApplyDiffuseLighting());
+        VertexFormat format = quad.getFormat();
+        if (format == DefaultVertexFormats.BLOCK)
+        {
+            out.writeByte(0);
+        }
+        else if (format == DefaultVertexFormats.ITEM)
+        {
+            out.writeByte(1);
+        }
+        else
+        {
+            throw new IOException("Unsupported BakedQuad format");
+        }
+    }
+
+    private static BakedQuad readQuad(DataInputStream in, TextureMap textureMap) throws IOException
+    {
+        int length = in.readInt();
+        int[] vertexData = new int[length];
+        for (int index = 0; index < length; index++)
+        {
+            vertexData[index] = in.readInt();
+        }
+        int tint = in.readInt();
+        int faceOrdinal = in.readByte();
+        EnumFacing face = faceOrdinal < 0 || faceOrdinal >= EnumFacing.values().length ? null : EnumFacing.values()[faceOrdinal];
+        String spriteName = in.readUTF();
+        TextureAtlasSprite sprite = spriteName.isEmpty() ? null : textureMap.getAtlasSprite(spriteName);
+        boolean diffuse = in.readBoolean();
+        int formatId = in.readByte();
+        VertexFormat format = formatId == 0 ? DefaultVertexFormats.BLOCK : DefaultVertexFormats.ITEM;
+        return new BakedQuad(vertexData, tint, face, sprite, diffuse, format);
+    }
+
+    private static void writeTransforms(DataOutputStream out, ItemCameraTransforms transforms) throws IOException
+    {
+        if (transforms == null || transforms == ItemCameraTransforms.DEFAULT)
+        {
+            out.writeByte(0);
+            return;
+        }
+        out.writeByte(1);
+        writeTransform(out, transforms.thirdperson_left);
+        writeTransform(out, transforms.thirdperson_right);
+        writeTransform(out, transforms.firstperson_left);
+        writeTransform(out, transforms.firstperson_right);
+        writeTransform(out, transforms.head);
+        writeTransform(out, transforms.gui);
+        writeTransform(out, transforms.ground);
+        writeTransform(out, transforms.fixed);
+    }
+
+    private static ItemCameraTransforms readTransforms(DataInputStream in) throws IOException
+    {
+        if (in.readByte() == 0)
+        {
+            return ItemCameraTransforms.DEFAULT;
+        }
+        return new ItemCameraTransforms(readTransform(in), readTransform(in), readTransform(in), readTransform(in),
+                readTransform(in), readTransform(in), readTransform(in), readTransform(in));
+    }
+
