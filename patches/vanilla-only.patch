+            return true;
+        }
+        for (EnumFacing facing : EnumFacing.values())
+        {
+            quads = model.getQuads(null, facing, 0L);
+            if (quads != null && !quads.isEmpty())
+            {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static byte[] serializeModel(IBakedModel model)
+    {
+        return serializeModel(model, 0);
+    }
+
+    private static byte[] serializeModel(IBakedModel model, int depth)
+    {
+        if (depth > 8)
+        {
+            return null;
+        }
+        try
+        {
+            ByteArrayOutputStream bytes = new ByteArrayOutputStream(8192);
+            try (DataOutputStream out = new DataOutputStream(bytes))
+            {
+                if (model.getClass() == SimpleBakedModel.class)
+                {
+                    out.writeByte(0);
+                    writeTransforms(out, model.getItemCameraTransforms());
+                    SimpleBakedModel simple = (SimpleBakedModel)model;
+                    out.writeBoolean(simple.isAmbientOcclusion());
+                    out.writeBoolean(simple.isGui3d());
+                    TextureAtlasSprite particle = simple.getParticleTexture();
+                    out.writeUTF(particle == null ? "" : particle.getIconName());
+                    writeQuads(out, simple.getQuads(null, null, 0L));
+                    for (EnumFacing facing : EnumFacing.values())
+                    {
+                        writeQuads(out, simple.getQuads(null, facing, 0L));
+                    }
+                }
+                else if (model.getClass() == BuiltInModel.class)
+                {
+                    out.writeByte(1);
+                    writeTransforms(out, model.getItemCameraTransforms());
+                }
+                else if (model.getClass() == WeightedBakedModel.class)
+                {
+                    out.writeByte(2);
+                    List<WeightedBakedModel.WeightedModel> entries = ((WeightedBakedModel)model).getModelsForCache();
+                    out.writeInt(entries.size());
+                    for (WeightedBakedModel.WeightedModel entry : entries)
+                    {
+                        byte[] sub = serializeModel(entry.model, depth + 1);
+                        if (sub == null)
+                        {
+                            return null;
+                        }
+                        out.writeInt(entry.itemWeight);
+                        out.writeInt(sub.length);
+                        out.write(sub);
+                    }
+                }
